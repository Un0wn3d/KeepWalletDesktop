<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://KeepWalletDesktop/Assets/Styles/Themes/Theme1/Colors.axaml" />
    <ResourceInclude Source="avares://KeepWalletDesktop/Assets/Styles/Themes/Theme1/Brushes.axaml" />
    <ResourceInclude Source="avares://KeepWalletDesktop/Assets/Styles/Themes/Theme1/Fonts.axaml" />
  </ResourceDictionary.MergedDictionaries>

  <CornerRadius x:Key="Radius.Base">8</CornerRadius>
  <CornerRadius x:Key="Radius.Card">8</CornerRadius>
  <CornerRadius x:Key="Radius.Round">999</CornerRadius>
  <Thickness x:Key="Spacing.CardPadding">24</Thickness>
  <Thickness x:Key="Spacing.CardPaddingCompact">16</Thickness>
  <BoxShadows x:Key="Shadow.Card">0 8 24 0 #14000000</BoxShadows>
  <BoxShadows x:Key="Shadow.Floating">0 18 42 0 #26000000</BoxShadows>
</ResourceDictionary>
