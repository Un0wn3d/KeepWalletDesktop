<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="AppColor.Background">#F9FAFB</Color>
  <Color x:Key="AppColor.Card">#FFFFFF</Color>
  <Color x:Key="AppColor.CardAlt">#F3F4F6</Color>
  <Color x:Key="AppColor.TextPrimary">#1F2937</Color>
  <Color x:Key="AppColor.TextSecondary">#6B7280</Color>
  <Color x:Key="AppColor.Border">#E5E7EB</Color>
  <Color x:Key="AppColor.Accent">#0078D4</Color>
  <Color x:Key="AppColor.AccentSoft">#EAF4FF</Color>
  <Color x:Key="AppColor.Income">#10B981</Color>
  <Color x:Key="AppColor.Expense">#374151</Color>
  <Color x:Key="AppColor.Danger">#EF4444</Color>
  <Color x:Key="AppColor.Overlay">#660F172A</Color>
  <Color x:Key="AppColor.Sidebar">#111827</Color>
</ResourceDictionary>
