<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Color.LeftPanelView">#070B12</SolidColorBrush>
  <LinearGradientBrush x:Key="Color.Background" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#07111F" Offset="0.0"/>
    <GradientStop Color="#0E1729" Offset="0.55"/>
    <GradientStop Color="#182235" Offset="1.0"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Color.Surface">#142136</SolidColorBrush>
  <SolidColorBrush x:Key="Color.SurfaceAlt">#1A2B45</SolidColorBrush>
  <SolidColorBrush x:Key="Color.SurfaceStrong">#243B5F</SolidColorBrush>
  <SolidColorBrush x:Key="Color.SurfaceOverlay">#1D2F4A</SolidColorBrush>
  <SolidColorBrush x:Key="Color.BorderSoft">#4C6A8F</SolidColorBrush>
  <SolidColorBrush x:Key="Color.Text1">#EEF6FF</SolidColorBrush>
  <SolidColorBrush x:Key="Color.Text2">#07111F</SolidColorBrush>
  <SolidColorBrush x:Key="Color.TextMuted">#B8C9DF</SolidColorBrush>
  <SolidColorBrush x:Key="Color.Accent">#76AEFF</SolidColorBrush>
  <SolidColorBrush x:Key="Color.AccentSoft">#243F68</SolidColorBrush>
  <SolidColorBrush x:Key="Color.InputSurface">#203657</SolidColorBrush>
  <SolidColorBrush x:Key="Color.InputSurfaceHover">#29466F</SolidColorBrush>
  <SolidColorBrush x:Key="Color.InputBorder">#6EA8FF</SolidColorBrush>
  <SolidColorBrush x:Key="Color.Success">#5EE0A0</SolidColorBrush>
  <SolidColorBrush x:Key="Color.SuccessPanel">#174B3D</SolidColorBrush>
  <SolidColorBrush x:Key="Color.Danger">#FF7A7A</SolidColorBrush>
  <SolidColorBrush x:Key="Color.DangerPanel">#5A2432</SolidColorBrush>
  <SolidColorBrush x:Key="Color.InfoPanel">#1B4778</SolidColorBrush>
  <SolidColorBrush x:Key="Color.AquaPanel">#124E58</SolidColorBrush>
  <SolidColorBrush x:Key="Color.Overlay">#8C050A12</SolidColorBrush>

  <StaticResource x:Key="Brush.AppBackground" ResourceKey="Color.Background" />
  <StaticResource x:Key="Brush.Card" ResourceKey="Color.Surface" />
  <StaticResource x:Key="Brush.CardAlt" ResourceKey="Color.SurfaceAlt" />
  <StaticResource x:Key="Brush.TextPrimary" ResourceKey="Color.Text1" />
  <StaticResource x:Key="Brush.TextSecondary" ResourceKey="Color.TextMuted" />
  <StaticResource x:Key="Brush.Border" ResourceKey="Color.BorderSoft" />
  <StaticResource x:Key="Brush.Accent" ResourceKey="Color.Accent" />
  <StaticResource x:Key="Brush.AccentSoft" ResourceKey="Color.AccentSoft" />
  <StaticResource x:Key="Brush.Income" ResourceKey="Color.Success" />
  <StaticResource x:Key="Brush.Expense" ResourceKey="Color.Text1" />
  <StaticResource x:Key="Brush.Danger" ResourceKey="Color.Danger" />
  <StaticResource x:Key="Brush.Overlay" ResourceKey="Color.Overlay" />
  <StaticResource x:Key="Brush.Sidebar" ResourceKey="Color.LeftPanelView" />
</ResourceDictionary>
