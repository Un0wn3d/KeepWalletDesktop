<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="Font.Interface">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
  <FontFamily x:Key="EmojiFontFamily">avares://KeepWalletDesktop/Assets/Fonts/NotoColorEmoji.ttf#Noto Color Emoji</FontFamily>
  <FontFamily x:Key="Phosphor">avares://KeepWalletDesktop/Assets/Fonts/Phosphor.ttf#Phosphor</FontFamily>
  <FontFamily x:Key="Phosphor-Bold">avares://KeepWalletDesktop/Assets/Fonts/Phosphor-Bold.ttf#Phosphor-Bold</FontFamily>
  <FontFamily x:Key="Phosphor-Duotone">avares://KeepWalletDesktop/Assets/Fonts/Phosphor-Duotone.ttf#Phosphor-Duotone</FontFamily>
  <FontFamily x:Key="Phosphor-Fill">avares://KeepWalletDesktop/Assets/Fonts/Phosphor-Fill.ttf#Phosphor-Fill</FontFamily>
  <FontFamily x:Key="Phosphor-Light">avares://KeepWalletDesktop/Assets/Fonts/Phosphor-Light.ttf#Phosphor-Light</FontFamily>
  <FontFamily x:Key="Phosphor-Thin">avares://KeepWalletDesktop/Assets/Fonts/Phosphor-Thin.ttf#Phosphor-Thin</FontFamily>
</ResourceDictionary>
