<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="720"
             x:Class="KeepWalletDesktop.Views.ReportingView"
             x:DataType="vm:MainViewModel">
    <Border Grid.Column="1" Margin="16" IsVisible="{Binding IsReportingPage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="1120">
                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding Texts.ReportingTitle}" Classes="page-title" />
                    <Button Grid.Column="1"
                            Content="{Binding Texts.ExportPdfButton}"
                            Classes="secondary-button"
                            Command="{Binding ExportReportPdfCommand}" />
                    <Button Grid.Column="2"
                            Content="{Binding Texts.ExportExcelButton}"
                            Classes="primary-button"
                            Command="{Binding ExportReportExcelCommand}" />
                </Grid>

                <Border Classes="panel-card alt">
                    <Grid ColumnDefinitions="2*, Auto, Auto, 2*" ColumnSpacing="8">
                        <ComboBox ItemsSource="{Binding ReportViewOptions}"
                                  SelectedItem="{Binding SelectedReportView}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CalendarDatePicker Grid.Column="1"
                                            SelectedDate="{Binding ReportDateFrom, Mode=TwoWay}" />
                        <CalendarDatePicker Grid.Column="2"
                                            SelectedDate="{Binding ReportDateTo, Mode=TwoWay}" />
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{Binding ReportCategoryOptions}"
                                  SelectedItem="{Binding SelectedReportCategory}"
                                  IsVisible="{Binding IsCategoryPeriodReportView}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="12">
                    <Border Grid.Column="0" Classes="panel-card alt">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Texts.Income}" Classes="muted" />
                            <TextBlock Text="{Binding ReportIncomeTotal, StringFormat={}{0:N2}}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="panel-card alt">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Texts.Expenses}" Classes="muted" />
                            <TextBlock Text="{Binding ReportExpenseTotal, StringFormat={}{0:N2}}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="panel-card alt">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Texts.BalanceLabel}" Classes="muted" />
                            <TextBlock Text="{Binding ReportBalanceTotal, StringFormat={}{0:N2}}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Classes="panel-card"
                        IsVisible="{Binding IsCategoryPeriodReportView}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Texts.ReportCategoryPeriodTitle}" Classes="card-title" />
                        <TextBlock Text="{Binding ReportSelectedCategoryExpenseTotalDisplay}" />
                        <TextBlock Text="{Binding ReportSelectedCategoryTransactionCountDisplay}" Classes="muted" />
                    </StackPanel>
                </Border>

                <Border Classes="panel-card"
                        IsVisible="{Binding IsMonthlyPlanReportView}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding Texts.ReportMonthlyPlanTitle}" Classes="card-title" />
                        <ItemsControl ItemsSource="{Binding CategoryDetails}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryDetailItemViewModel">
                                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12" Margin="0,4">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Text="{Binding AmountDisplay, StringFormat={}{0}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding LimitDisplay, StringFormat={}{0}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="panel-card"
                        IsVisible="{Binding IsMonthlyExpensesReportView}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding Texts.ReportMonthlyExpensesOption}" Classes="card-title" />
                        <ItemsControl ItemsSource="{Binding ReportMonthlyExpenses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryLegendItemViewModel">
                                    <Grid ColumnDefinitions="16, *, Auto" ColumnSpacing="8" Margin="0,4">
                                        <Border Width="10"
                                                Height="10"
                                                CornerRadius="5"
                                                Background="{Binding ColorBrush}"
                                                VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="2" Text="{Binding AmountDisplay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                    <Border Classes="panel-card">
                        <Grid RowDefinitions="Auto, *" RowSpacing="12">
                            <TextBlock Text="{Binding Texts.TransactionBreakdownTitle}" Classes="card-title" />
                            <Grid Grid.Row="1" ColumnDefinitions="*, 220" ColumnSpacing="10">
                                <lvc:PieChart x:Name="ReportExpensePieChart"
                                              Grid.Column="0"
                                              Background="{DynamicResource Color.SurfaceAlt}"
                                              LegendPosition="Hidden"
                                              Series="{Binding Series}" />
                                <ItemsControl Grid.Column="1"
                                              ItemsSource="{Binding ExpenseCategoryLegend}"
                                              IsVisible="{Binding HasExpenseTransactions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CategoryLegendItemViewModel">
                                            <Grid ColumnDefinitions="14, *, Auto" ColumnSpacing="8" Margin="0,4">
                                                <Border Width="10"
                                                        Height="10"
                                                        CornerRadius="5"
                                                        Background="{Binding ColorBrush}"
                                                        VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding AmountDisplay}"
                                                           Classes="muted"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Texts.ChartNoDataText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding HasNoExpenseTransactions}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Classes="panel-card">
                        <Grid RowDefinitions="Auto, *" RowSpacing="12">
                            <TextBlock Text="{Binding TransactionTimelineTitle}" Classes="card-title" />
                            <Grid Grid.Row="1">
                                <lvc:CartesianChart x:Name="ReportTimelineChart"
                                                    Background="{DynamicResource Color.SurfaceAlt}"
                                                    Series="{Binding Chart}"
                                                    XAxes="{Binding TransactionTimelineXAxes}"
                                                    YAxes="{Binding TransactionTimelineYAxes}"
                                                    ZoomMode="X" />
                                <TextBlock Text="{Binding Texts.ChartNoDataText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding HasNoTransactions}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                    <Border Classes="panel-card">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Texts.BankAccountsTitle}" Classes="card-title" />
                            <ItemsControl ItemsSource="{Binding BankAccounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BankAccountItemViewModel">
                                        <Grid ColumnDefinitions="*, Auto" Margin="0,3">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Text="{Binding BalanceDisplay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="panel-card">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Texts.SavingsTitle}" Classes="card-title" />
                            <ItemsControl ItemsSource="{Binding Savings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SavingOptionViewModel">
                                        <Grid ColumnDefinitions="*, Auto" Margin="0,3">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Text="{Binding AmountDisplay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Classes="panel-card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding Texts.RecentTransactionsTitle}" Classes="card-title" />
                        <ItemsControl ItemsSource="{Binding AllTransactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TransactionItemViewModel">
                                    <Grid ColumnDefinitions="140, *, 120, 120" ColumnSpacing="8" Margin="0,3">
                                        <TextBlock Text="{Binding TransactionDateDisplay}" Classes="muted" />
                                        <TextBlock Grid.Column="1" Text="{Binding DescriptionDisplay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CategoryDisplay}" Classes="muted" />
                                        <TextBlock Grid.Column="3" Text="{Binding AmountDisplay}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding ReportStatusMessage}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
