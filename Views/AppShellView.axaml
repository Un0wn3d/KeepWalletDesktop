<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:views="clr-namespace:KeepWalletDesktop.Views"
             xmlns:controls="clr-namespace:KeepWalletDesktop.Views.Controls"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="KeepWalletDesktop.Views.AppShellView"
             x:DataType="vm:MainViewModel"
             Focusable="True"
             KeyDown="AppShell_OnKeyDown">
    <Grid ColumnDefinitions="Auto, *" MinWidth="500">
        <controls:LeftPanel Grid.Column="0"
                            IsVisible="{Binding CanOpenAppPages}" />

        <views:HomeView Grid.Column="1" />
        <views:BankAccountsView Grid.Column="1" />
        <views:SavingsView Grid.Column="1" IsVisible="{Binding IsSavingsPage}" />
        <views:GroupsView Grid.Column="1" />
        <views:ScheduledPaymentsView Grid.Column="1" />
        <views:CategoriesView Grid.Column="1" />
        <views:ReportingView Grid.Column="1" />
        <views:ApiSettingsView Grid.Column="1" />

        <controls:FloatingActionMenu Grid.Column="1"
                                     IsVisible="{Binding IsHomePage}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,24,24" />

        <controls:AllTransactionsDialog Grid.Column="1" />
        <Border Grid.ColumnSpan="2"
                IsVisible="{Binding IsMissingBankAccountPromptOpen}"
                Background="{DynamicResource Color.Overlay}">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="420">
                <Border Classes="dialog-card">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding Texts.MissingBankAccountPromptTitle}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MissingBankAccountPromptMessage}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button Content="{Binding Texts.NoButton}"
                                    Classes="secondary-button"
                                    Command="{Binding CancelCreateBankAccountFromPromptCommand}" />
                            <Button Content="{Binding Texts.YesButton}"
                                    Classes="primary-button"
                                    Command="{Binding ConfirmCreateBankAccountFromPromptCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.ColumnSpan="2"
                IsVisible="{Binding IsDeleteCategoryPromptOpen}"
                Background="{DynamicResource Color.Overlay}">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="460">
                <Border Classes="dialog-card">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding Texts.DeleteCategoryPromptTitle}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DeleteCategoryPromptMessage}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button Content="{Binding Texts.NoButton}"
                                    Classes="secondary-button"
                                    Command="{Binding CancelDeleteCategoryCommand}" />
                            <Button Content="{Binding Texts.YesButton}"
                                    Classes="danger-button"
                                    Command="{Binding ConfirmDeleteCategoryCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.ColumnSpan="2"
                IsVisible="{Binding IsCategoryDetailsOpen}"
                Background="{DynamicResource Color.Overlay}"
                PointerPressed="CategoryDetailsOverlay_OnPointerPressed">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="860"
                  MaxHeight="640">
                <Border Classes="dialog-card">
                    <Grid>
                    <Grid RowDefinitions="Auto, *" RowSpacing="16"
                          IsVisible="{Binding !IsCategorySettingsMode}">
                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding Texts.TransactionBreakdownTitle}"
                                       FontSize="24"
                                       FontWeight="Bold" />
                            <Button Grid.Column="1"
                                    Content="{Binding Texts.OnboardingCategoriesTitle}"
                                    Classes="secondary-button"
                                    Command="{Binding OpenCategorySettingsCommand}" />
                            <Button Grid.Column="2"
                                    Content="{Binding Texts.SaveServerSettingsButton}"
                                    Classes="primary-button"
                                    Command="{Binding SaveCategoryDetailsCommand}" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CategoryDetails}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CategoryDetailItemViewModel">
                                        <Border Classes="list-item-card"
                                                Width="250"
                                                Margin="0,0,16,16"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource Color.BorderSoft}">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="14, *"
                                                      ColumnSpacing="8"
                                                      MinHeight="35">
                                                    <Border Width="10"
                                                            Height="10"
                                                            CornerRadius="5"
                                                            Background="{Binding ColorBrush}"
                                                            VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                </Grid>

                                                <Grid Height="170" Margin="0,0,0,0">
                                                    <lvc:PieChart Series="{Binding GaugeSeries}"
                                                                  Width="158"
                                                                  Height="158"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  InitialRotation="-225"
                                                                  MaxAngle="270"
                                                                  MinValue="0"
                                                                  Margin="0,18,0,0"
                                                                  LegendPosition="Hidden"
                                                                  TooltipPosition="Hidden" />
                                                    <TextBlock Text="{Binding UsageDisplay}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="20"
                                                               FontWeight="Bold" />
                                                </Grid>

                                                <Grid ColumnDefinitions="Auto, Auto, *"
                                                      ColumnSpacing="4"
                                                      HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding AmountDisplay}"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="/"
                                                               Classes="muted"
                                                               VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="2"
                                                             Text="{Binding LimitInput, UpdateSourceTrigger=PropertyChanged}"
                                                             MinWidth="90" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid RowDefinitions="Auto, *"
                          RowSpacing="16"
                          IsVisible="{Binding IsCategorySettingsMode}">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <Border />
                            <Button Grid.Column="1"
                                    Content="{Binding Texts.CancelButton}"
                                    Classes="secondary-button"
                                    Command="{Binding CloseCategoryDetailsCommand}" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <Border Classes="panel-card alt">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{Binding Texts.OnboardingAddCategoryTitle}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="*, 160, Auto, Auto, Auto" ColumnSpacing="8">
                                            <TextBox Text="{Binding CategoryNewName}"
                                                     Watermark="{Binding Texts.OnboardingCategoryNameHint}" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding CategoryIconOptions}"
                                                      SelectedValue="{Binding CategoryNewIconKey}"
                                                      SelectedValueBinding="{Binding Key}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CategoryIconOptionViewModel">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Glyph}"
                                                                       FontFamily="{DynamicResource Phosphor-Fill}" />
                                                            <TextBlock Text="{Binding DisplayName}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="2"
                                                    Content="{Binding Texts.TransactionExpenseType}"
                                                    Classes="secondary-button"
                                                    Command="{Binding SelectCategoryTypeCommand}"
                                                    CommandParameter="expense" />
                                            <Button Grid.Column="3"
                                                    Content="{Binding Texts.TransactionIncomeType}"
                                                    Classes="secondary-button"
                                                    Command="{Binding SelectCategoryTypeCommand}"
                                                    CommandParameter="income" />
                                            <Button Grid.Column="4"
                                                    Content="{Binding Texts.OnboardingAddCategoryButton}"
                                                    Classes="primary-button"
                                                    Command="{Binding AddCategoryCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                                    <Border Classes="panel-card">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="{Binding Texts.TransactionExpenseType}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding ExpenseCategories}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CategoryManagementItemViewModel">
                                                        <Grid ColumnDefinitions="Auto, *, 140, Auto, Auto" ColumnSpacing="10" Margin="0,4">
                                                            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource Color.SurfaceAlt}">
                                                                <TextBlock Text="{Binding IconGlyph}"
                                                                           FontFamily="{DynamicResource Phosphor-Fill}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                                                <TextBlock Text="{Binding TypeDisplay}" Classes="muted" />
                                                            </StackPanel>
                                                            <ComboBox Grid.Column="2"
                                                                      ItemsSource="{ReflectionBinding $parent[UserControl].DataContext.CategoryIconOptions}"
                                                                      SelectedValue="{Binding SelectedIconKey}"
                                                                      SelectedValueBinding="{ReflectionBinding Key}"
                                                                      SelectionChanged="CategorySettings_OnChanged">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:CategoryIconOptionViewModel">
                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                            <TextBlock Text="{Binding Glyph}"
                                                                                       FontFamily="{DynamicResource Phosphor-Fill}" />
                                                                            <TextBlock Text="{Binding DisplayName}" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <ToggleSwitch Grid.Column="3"
                                                                          IsChecked="{Binding IsSelected}"
                                                                          Checked="CategorySettings_OnChanged"
                                                                          Unchecked="CategorySettings_OnChanged" />
                                                            <Button Grid.Column="4"
                                                                    Width="44"
                                                                    Height="44"
                                                                    Padding="0"
                                                                    HorizontalContentAlignment="Center"
                                                                    VerticalContentAlignment="Center"
                                                                    Classes="danger-button"
                                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.DeleteCategoryCommand}"
                                                                    CommandParameter="{Binding .}">
                                                                <Viewbox Width="18" Height="18">
                                                                    <TextBlock Text="&#xE4A6;"
                                                                               FontFamily="{DynamicResource Phosphor-Fill}"
                                                                               TextAlignment="Center"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                </Viewbox>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Classes="panel-card">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="{Binding Texts.TransactionIncomeType}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding IncomeCategories}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CategoryManagementItemViewModel">
                                                        <Grid ColumnDefinitions="Auto, *, 140, Auto, Auto" ColumnSpacing="10" Margin="0,4">
                                                            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource Color.SuccessPanel}">
                                                                <TextBlock Text="{Binding IconGlyph}"
                                                                           FontFamily="{DynamicResource Phosphor-Fill}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                                                <TextBlock Text="{Binding TypeDisplay}" Classes="muted" />
                                                            </StackPanel>
                                                            <ComboBox Grid.Column="2"
                                                                      ItemsSource="{ReflectionBinding $parent[UserControl].DataContext.CategoryIconOptions}"
                                                                      SelectedValue="{Binding SelectedIconKey}"
                                                                      SelectedValueBinding="{ReflectionBinding Key}"
                                                                      SelectionChanged="CategorySettings_OnChanged">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:CategoryIconOptionViewModel">
                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                            <TextBlock Text="{Binding Glyph}"
                                                                                       FontFamily="{DynamicResource Phosphor-Fill}" />
                                                                            <TextBlock Text="{Binding DisplayName}" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <ToggleSwitch Grid.Column="3"
                                                                          IsChecked="{Binding IsSelected}"
                                                                          Checked="CategorySettings_OnChanged"
                                                                          Unchecked="CategorySettings_OnChanged" />
                                                            <Button Grid.Column="4"
                                                                    Width="44"
                                                                    Height="44"
                                                                    Padding="0"
                                                                    HorizontalContentAlignment="Center"
                                                                    VerticalContentAlignment="Center"
                                                                    Classes="danger-button"
                                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.DeleteCategoryCommand}"
                                                                    CommandParameter="{Binding .}">
                                                                <Viewbox Width="18" Height="18">
                                                                    <TextBlock Text="&#xE4A6;"
                                                                               FontFamily="{DynamicResource Phosphor-Fill}"
                                                                               TextAlignment="Center"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                </Viewbox>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Classes="panel-card alt">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{Binding Texts.MergeCategoriesTitle}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="*, *, Auto" ColumnSpacing="8">
                                            <ComboBox ItemsSource="{Binding Categories}"
                                                      SelectedItem="{Binding SelectedMergeSourceCategory}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CategoryManagementItemViewModel">
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding MergeTargetCategories}"
                                                      SelectedItem="{Binding SelectedMergeTargetCategory}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CategoryManagementItemViewModel">
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="2"
                                                    Content="{Binding Texts.MergeCategoriesButton}"
                                                    Classes="primary-button"
                                                    Command="{Binding MergeCategoriesCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding CategoryStatusMessage}"
                                           Classes="muted"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <controls:TransactionDialog Grid.ColumnSpan="2" />
        <controls:BankAccountDialog Grid.ColumnSpan="2" />
    </Grid>
</UserControl>
