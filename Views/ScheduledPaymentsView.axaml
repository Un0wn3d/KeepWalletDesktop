<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="720"
             x:Class="KeepWalletDesktop.Views.ScheduledPaymentsView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="Button.scheduled-filter-button">
            <Setter Property="Background" Value="{DynamicResource Color.InputSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource Color.Text1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Color.InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
        <Style Selector="Button.scheduled-filter-button.active">
            <Setter Property="BorderBrush" Value="{DynamicResource Color.Accent}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.scheduled-advanced-filter-button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Color.InputSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource Color.Text1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Color.InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.scheduled-advanced-filter-button.active">
            <Setter Property="BorderBrush" Value="{DynamicResource Color.Accent}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Styles>
    <Border Grid.Column="1" Margin="12" IsVisible="{Binding IsScheduledPaymentsPage}">
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Classes="panel-card alt">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Texts.ScheduledPaymentsTotalCardTitle}" Classes="muted" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ScheduledPaymentsTotalCount}" FontSize="24" FontWeight="Bold" />
                                <TextBlock Text="{Binding ScheduledPaymentsTotalAmountDisplay}" Classes="muted" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="panel-card alt">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Texts.ScheduledPaymentsPaidThisMonthCardTitle}" Classes="muted" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ScheduledPaymentsPaidThisMonthCount}" FontSize="24" FontWeight="Bold" />
                                <TextBlock Text="{Binding ScheduledPaymentsPaidThisMonthAmountDisplay}" Classes="muted" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="panel-card alt">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Texts.ScheduledPaymentsUnpaidCardTitle}" Classes="muted" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ScheduledPaymentsUnpaidCount}" FontSize="24" FontWeight="Bold" />
                                <TextBlock Text="{Binding ScheduledPaymentsUnpaidAmountDisplay}" Classes="muted" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Classes="panel-card alt">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Texts.ScheduledPaymentsOverdueCardTitle}" Classes="muted" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ScheduledPaymentsOverdueCount}" FontSize="24" FontWeight="Bold" />
                                <TextBlock Text="{Binding ScheduledPaymentsOverdueAmountDisplay}" Classes="muted" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Classes="panel-card alt">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Left">
                                <Button Content="{Binding Texts.ScheduledPaymentsFilterAll}"
                                        Classes="scheduled-filter-button active"
                                        IsVisible="{Binding IsAllScheduledPaymentsFilterSelected}"
                                        Command="{Binding SetScheduledPaymentsFilterCommand}"
                                        CommandParameter="all" />
                                <Button Content="{Binding Texts.ScheduledPaymentsFilterAll}"
                                        Classes="scheduled-filter-button"
                                        IsVisible="{Binding !IsAllScheduledPaymentsFilterSelected}"
                                        Command="{Binding SetScheduledPaymentsFilterCommand}"
                                        CommandParameter="all" />
                                <Button Content="{Binding Texts.ScheduledPaymentsFilterFuture}"
                                        Classes="scheduled-filter-button active"
                                        IsVisible="{Binding IsFutureScheduledPaymentsFilterSelected}"
                                        Command="{Binding SetScheduledPaymentsFilterCommand}"
                                        CommandParameter="future" />
                                <Button Content="{Binding Texts.ScheduledPaymentsFilterFuture}"
                                        Classes="scheduled-filter-button"
                                        IsVisible="{Binding !IsFutureScheduledPaymentsFilterSelected}"
                                        Command="{Binding SetScheduledPaymentsFilterCommand}"
                                        CommandParameter="future" />
                                <Button Content="{Binding Texts.ScheduledPaymentsFilterOverdue}"
                                        Classes="scheduled-filter-button active"
                                        IsVisible="{Binding IsOverdueScheduledPaymentsFilterSelected}"
                                        Command="{Binding SetScheduledPaymentsFilterCommand}"
                                        CommandParameter="overdue" />
                                <Button Content="{Binding Texts.ScheduledPaymentsFilterOverdue}"
                                        Classes="scheduled-filter-button"
                                        IsVisible="{Binding !IsOverdueScheduledPaymentsFilterSelected}"
                                        Command="{Binding SetScheduledPaymentsFilterCommand}"
                                        CommandParameter="overdue" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right">
                                <Button Classes="scheduled-advanced-filter-button"
                                        Classes.active="{Binding HasScheduledPaymentAdvancedFilter}">
                                    <TextBlock Text="&#xE4D6;"
                                               FontFamily="{DynamicResource Phosphor}"
                                               FontSize="19"
                                               Foreground="{DynamicResource Color.Text1}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom"
                                                VerticalOffset="8">
                                            <Border Width="360"
                                                    Padding="16"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource Color.Surface}">
                                                <StackPanel Spacing="12">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Text="{Binding Texts.ScheduledPaymentsGroupsFilterTitle}"
                                                                   Classes="form-label"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="1"
                                                                Classes="link-button"
                                                                Command="{Binding ClearScheduledPaymentAdvancedFiltersCommand}">
                                                            <TextBlock Text="&#xE26C;"
                                                                       FontFamily="{DynamicResource Phosphor}"
                                                                       FontSize="18"
                                                                       VerticalAlignment="Center" />
                                                        </Button>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding ScheduledPaymentGroupFilterOptions}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:FilterSelectionOptionViewModel">
                                                                <CheckBox Content="{Binding DisplayName}"
                                                                          IsChecked="{Binding IsSelected}"
                                                                          Margin="0,0,12,8"
                                                                          IsCheckedChanged="ScheduledPaymentAdvancedFilter_OnChanged" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock Text="{Binding Texts.ScheduledPaymentsUsersFilterTitle}"
                                                               Classes="form-label" />
                                                    <ItemsControl ItemsSource="{Binding ScheduledPaymentUserFilterOptions}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:FilterSelectionOptionViewModel">
                                                                <CheckBox Content="{Binding DisplayName}"
                                                                          IsChecked="{Binding IsSelected}"
                                                                          Margin="0,0,12,8"
                                                                          IsCheckedChanged="ScheduledPaymentAdvancedFilter_OnChanged" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <ComboBox Width="120"
                                          MinHeight="34"
                                          ItemsSource="{Binding ScheduledPaymentCurrencyFilterOptions}"
                                          SelectedItem="{Binding SelectedScheduledPaymentCurrencyFilter}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox Width="130"
                                          MinHeight="34"
                                          IsVisible="{Binding HasScheduledPaymentTypeFilter}"
                                          ItemsSource="{Binding ScheduledPaymentTypeFilterOptions}"
                                          SelectedItem="{Binding SelectedScheduledPaymentTypeFilter}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox Width="180"
                                          MinHeight="34"
                                          ItemsSource="{Binding ScheduledPaymentCategoryFilterOptions}"
                                          SelectedItem="{Binding SelectedScheduledPaymentCategoryFilter}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Classes="panel-card">
                        <StackPanel Spacing="10">
                            <ItemsControl ItemsSource="{Binding FilteredScheduledPayments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScheduledPaymentItemViewModel">
                                        <Grid>
                                            <Border Classes="list-item-card"
                                                    Margin="0,2"
                                                    IsVisible="{Binding !IsOverdue}">
                                                <Grid ColumnDefinitions="52,*,96,180,Auto,110,80"
                                                      ColumnSpacing="12"
                                                      VerticalAlignment="Center">
                                                    <Button Grid.Column="0"
                                                            Grid.ColumnSpan="7"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Command="{ReflectionBinding $parent[UserControl].DataContext.ToggleScheduledPaymentCommand}"
                                                            CommandParameter="{Binding .}">
                                                        <Grid ColumnDefinitions="52,*,96,180,Auto,110,80"
                                                              ColumnSpacing="12"
                                                              VerticalAlignment="Center">
                                                            <Border Width="40"
                                                                    Height="40"
                                                                    CornerRadius="8"
                                                                    Background="{Binding CategoryAnchorBrush}">
                                                                <TextBlock Text="{Binding CategoryIcon}"
                                                                           FontFamily="{StaticResource EmojiFontFamily}"
                                                                           FontSize="18"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <Grid Grid.Column="1" ColumnDefinitions="220, Auto, *" ColumnSpacing="8" ClipToBounds="True">
                                                                <StackPanel Spacing="2" ClipToBounds="True">
                                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding DueDateDisplay}" Classes="muted" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Border Grid.Column="1"
                                                                        Background="{Binding GroupBrush}"
                                                                        CornerRadius="20"
                                                                        Padding="12,6"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Left"
                                                                        MinWidth="{ReflectionBinding $parent[UserControl].DataContext.ScheduledPaymentGroupPillWidth}"
                                                                       IsVisible="{Binding IsShared}">
                                                                    <TextBlock Text="{Binding GroupDisplay}"
                                                                               HorizontalAlignment="Center"
                                                                               TextAlignment="Center"
                                                                               TextWrapping="Wrap"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Frequency}"
                                                                       Classes="muted"
                                                                       HorizontalAlignment="Left"
                                                                       TextAlignment="Left"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding DaysRemainingDisplay}"
                                                                       Foreground="{DynamicResource Color.Success}"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Left"
                                                                       TextAlignment="Left"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsDueFar}" />
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding DaysRemainingDisplay}"
                                                                       Foreground="#D1A100"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Left"
                                                                       TextAlignment="Left"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsDueLater}" />
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding DaysRemainingDisplay}"
                                                                       Foreground="{DynamicResource Color.Danger}"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Left"
                                                                       TextAlignment="Left"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsDueSoon}" />
                                                            <Border Grid.Column="4"
                                                                    Background="{Binding CategoryAnchorBrush}"
                                                                    CornerRadius="20"
                                                                    Padding="12,6"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Left"
                                                                    Width="{ReflectionBinding $parent[UserControl].DataContext.ScheduledPaymentCategoryPillWidth}">
                                                                <TextBlock Text="{Binding CategoryDisplay}"
                                                                           HorizontalAlignment="Center"
                                                                           TextAlignment="Center"
                                                                           TextWrapping="Wrap"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <Grid Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Left" ClipToBounds="True">
                                                                <TextBlock Text="{Binding AmountWithSymbolDisplay}" Foreground="{DynamicResource Color.Success}" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsIncome}" />
                                                                <TextBlock Text="{Binding AmountWithSymbolDisplay}" Foreground="{DynamicResource Color.Danger}" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsIncome}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <Border Classes="list-item-card"
                                                    Margin="0,2"
                                                    Background="{DynamicResource Color.DangerPanel}"
                                                    BorderBrush="{DynamicResource Color.Danger}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding IsOverdue}">
                                                <Grid ColumnDefinitions="52,*,96,180,Auto,110,80"
                                                      ColumnSpacing="12"
                                                      VerticalAlignment="Center">
                                                    <Button Grid.Column="0"
                                                            Grid.ColumnSpan="7"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Command="{ReflectionBinding $parent[UserControl].DataContext.ToggleScheduledPaymentCommand}"
                                                            CommandParameter="{Binding .}">
                                                        <Grid ColumnDefinitions="52,*,96,180,Auto,110,80"
                                                              ColumnSpacing="12"
                                                              VerticalAlignment="Center">
                                                            <Border Width="40"
                                                                    Height="40"
                                                                    CornerRadius="8"
                                                                    Background="{Binding CategoryAnchorBrush}">
                                                                <TextBlock Text="{Binding CategoryIcon}"
                                                                           FontFamily="{StaticResource EmojiFontFamily}"
                                                                           FontSize="18"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <Grid Grid.Column="1" ColumnDefinitions="220, Auto, *" ColumnSpacing="8" ClipToBounds="True">
                                                                <StackPanel Spacing="2" ClipToBounds="True">
                                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding DueDateDisplay}" Classes="muted" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Border Grid.Column="1"
                                                                        Background="{Binding GroupBrush}"
                                                                        CornerRadius="20"
                                                                        Padding="12,6"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Left"
                                                                        MinWidth="{ReflectionBinding $parent[UserControl].DataContext.ScheduledPaymentGroupPillWidth}"
                                                                       IsVisible="{Binding IsShared}">
                                                                    <TextBlock Text="{Binding GroupDisplay}"
                                                                               HorizontalAlignment="Center"
                                                                               TextAlignment="Center"
                                                                               TextWrapping="Wrap"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Frequency}"
                                                                       Classes="muted"
                                                                       HorizontalAlignment="Left"
                                                                       TextAlignment="Left"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding DaysRemainingDisplay}"
                                                                       Foreground="{DynamicResource Color.Danger}"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Left"
                                                                       TextAlignment="Left"
                                                                       VerticalAlignment="Center" />
                                                            <Border Grid.Column="4"
                                                                    Background="{Binding CategoryAnchorBrush}"
                                                                    CornerRadius="20"
                                                                    Padding="12,6"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Left"
                                                                    Width="{ReflectionBinding $parent[UserControl].DataContext.ScheduledPaymentCategoryPillWidth}">
                                                                <TextBlock Text="{Binding CategoryDisplay}"
                                                                           HorizontalAlignment="Center"
                                                                           TextAlignment="Center"
                                                                           TextWrapping="Wrap"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <Grid Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Left" ClipToBounds="True">
                                                                <TextBlock Text="{Binding AmountWithSymbolDisplay}" Foreground="{DynamicResource Color.Success}" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsIncome}" />
                                                                <TextBlock Text="{Binding AmountWithSymbolDisplay}" Foreground="{DynamicResource Color.Danger}" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsIncome}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Button Classes="fab-button"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,20,20"
                    Command="{Binding BeginCreateScheduledPaymentCommand}">
                <TextBlock Text="+"
                           FontSize="34"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,1,5" />
            </Button>
        </Grid>
    </Border>
</UserControl>
