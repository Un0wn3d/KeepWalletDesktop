<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="KeepWalletDesktop.Views.ScheduledPaymentsView"
             x:DataType="vm:MainViewModel">
                <Border Grid.Column="1" Margin="10, 10, 10, 10" IsVisible="{Binding IsScheduledPaymentsPage}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="10">
                    <TextBlock Text="{Binding Texts.ScheduledPaymentsTitle}"
                               Classes="page-title" />

                    <Border Grid.Row="1" Classes="panel-card">
                        <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="8">
                            <Grid ColumnDefinitions="2*, *, *, *" ColumnSpacing="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Texts.ScheduledPaymentNameLabel}" />
                                    <TextBox Text="{Binding ScheduledPaymentNameInput}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Texts.TransactionAmountLabel}" />
                                    <TextBox Text="{Binding ScheduledPaymentAmountInput}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Texts.TransactionDateLabel}" />
                                    <TextBox Text="{Binding ScheduledPaymentDateInput}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="{Binding Texts.ScheduledPaymentRepeatLabel}" />
                                    <ComboBox ItemsSource="{Binding ScheduledRepeatOptions}"
                                              SelectedItem="{Binding SelectedScheduledRepeatOption}" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="Auto, Auto, *, *" ColumnSpacing="8">
                                <Button Content="{Binding Texts.TransactionExpenseType}"
                                        Classes="secondary-button"
                                        Command="{Binding SelectScheduledPaymentTypeCommand}"
                                        CommandParameter="expense" />
                                <Button Grid.Column="1"
                                        Content="{Binding Texts.TransactionIncomeType}"
                                        Classes="secondary-button"
                                        Command="{Binding SelectScheduledPaymentTypeCommand}"
                                        CommandParameter="income" />
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding ScheduledPaymentCategoryOptions}"
                                          SelectedItem="{Binding SelectedScheduledPaymentCategory}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Grid.Column="3"
                                         Text="{Binding ScheduledPaymentCustomRepeatInput}"
                                         Watermark="{Binding Texts.ScheduledPaymentCustomRepeatHint}"
                                         IsVisible="{Binding IsCustomScheduledRepeat}" />
                            </Grid>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="{Binding Texts.TransactionDescriptionLabel}" />
                                <TextBox Text="{Binding ScheduledPaymentDescriptionInput}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Grid.Row="2"
                            HorizontalAlignment="Left"
                            Content="{Binding Texts.AddScheduledPaymentButton}"
                            Command="{Binding AddScheduledPaymentCommand}" />

                    <ItemsControl Grid.Row="3" ItemsSource="{Binding ScheduledPayments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScheduledPaymentItemViewModel">
                                <Border Classes="list-item-card">
                                    <Grid ColumnDefinitions="2*, *, *, Auto" ColumnSpacing="12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CategoryDisplay}" Classes="muted" />
                                            <TextBlock Text="{Binding Frequency}" Classes="muted" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DueDateDisplay}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding AmountDisplay}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="3"
                                                Content="{Binding $parent[UserControl].DataContext.Texts.ConfirmScheduledPaymentButton}"
                                                Classes="primary-button"
                                                IsEnabled="{Binding IsActive}"
                                                Command="{Binding $parent[UserControl].DataContext.ToggleScheduledPaymentCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Border>
</UserControl>
