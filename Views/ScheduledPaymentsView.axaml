<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="720"
             x:Class="KeepWalletDesktop.Views.ScheduledPaymentsView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="Button.scheduled-filter-button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource Color.BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
        <Style Selector="Button.scheduled-filter-button.active">
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>
    <Border Grid.Column="1" Margin="12" IsVisible="{Binding IsScheduledPaymentsPage}">
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="{Binding Texts.ScheduledPaymentsTitle}" Classes="page-title" />
                        <Button Grid.Column="1" Content="{Binding Texts.AddScheduledPaymentButton}" Classes="primary-button" Command="{Binding AddScheduledPaymentCommand}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Classes="panel-card alt">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Texts.ScheduledPaymentsTotalCardTitle}" Classes="muted" />
                                <TextBlock Text="{Binding ScheduledPaymentsTotalCount}" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="panel-card alt">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Texts.ScheduledPaymentsPaidThisMonthCardTitle}" Classes="muted" />
                                <TextBlock Text="{Binding ScheduledPaymentsPaidThisMonthCount}" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="panel-card alt">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Texts.ScheduledPaymentsUnpaidCardTitle}" Classes="muted" />
                                <TextBlock Text="{Binding ScheduledPaymentsUnpaidCount}" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Classes="panel-card alt">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Texts.ScheduledPaymentsOverdueCardTitle}" Classes="muted" />
                                <TextBlock Text="{Binding ScheduledPaymentsOverdueCount}" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Classes="panel-card alt">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Left">
                                <Button Content="{Binding Texts.ScheduledPaymentsFilterAll}"
                                        Classes="scheduled-filter-button active"
                                        IsVisible="{Binding IsAllScheduledPaymentsFilterSelected}"
                                        Command="{Binding SetScheduledPaymentsFilterCommand}"
                                        CommandParameter="all" />
                                <Button Content="{Binding Texts.ScheduledPaymentsFilterAll}"
                                        Classes="scheduled-filter-button"
                                        IsVisible="{Binding !IsAllScheduledPaymentsFilterSelected}"
                                        Command="{Binding SetScheduledPaymentsFilterCommand}"
                                        CommandParameter="all" />
                                <Button Content="{Binding Texts.ScheduledPaymentsFilterFuture}"
                                        Classes="scheduled-filter-button active"
                                        IsVisible="{Binding IsFutureScheduledPaymentsFilterSelected}"
                                        Command="{Binding SetScheduledPaymentsFilterCommand}"
                                        CommandParameter="future" />
                                <Button Content="{Binding Texts.ScheduledPaymentsFilterFuture}"
                                        Classes="scheduled-filter-button"
                                        IsVisible="{Binding !IsFutureScheduledPaymentsFilterSelected}"
                                        Command="{Binding SetScheduledPaymentsFilterCommand}"
                                        CommandParameter="future" />
                                <Button Content="{Binding Texts.ScheduledPaymentsFilterOverdue}"
                                        Classes="scheduled-filter-button active"
                                        IsVisible="{Binding IsOverdueScheduledPaymentsFilterSelected}"
                                        Command="{Binding SetScheduledPaymentsFilterCommand}"
                                        CommandParameter="overdue" />
                                <Button Content="{Binding Texts.ScheduledPaymentsFilterOverdue}"
                                        Classes="scheduled-filter-button"
                                        IsVisible="{Binding !IsOverdueScheduledPaymentsFilterSelected}"
                                        Command="{Binding SetScheduledPaymentsFilterCommand}"
                                        CommandParameter="overdue" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right">
                                <ComboBox Width="120"
                                          MinHeight="34"
                                          ItemsSource="{Binding ScheduledPaymentCurrencyFilterOptions}"
                                          SelectedItem="{Binding SelectedScheduledPaymentCurrencyFilter}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox Width="130"
                                          MinHeight="34"
                                          IsVisible="{Binding HasScheduledPaymentTypeFilter}"
                                          ItemsSource="{Binding ScheduledPaymentTypeFilterOptions}"
                                          SelectedItem="{Binding SelectedScheduledPaymentTypeFilter}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox Width="180"
                                          MinHeight="34"
                                          ItemsSource="{Binding ScheduledPaymentCategoryFilterOptions}"
                                          SelectedItem="{Binding SelectedScheduledPaymentCategoryFilter}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Classes="panel-card">
                        <StackPanel Spacing="10">
                            <ItemsControl ItemsSource="{Binding FilteredScheduledPayments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScheduledPaymentItemViewModel">
                                        <Grid>
                                            <Border Classes="list-item-card"
                                                    Margin="0,2"
                                                    IsVisible="{Binding !IsOverdue}">
                                                <Grid ColumnDefinitions="52,*,96,180,120,110"
                                                      ColumnSpacing="12"
                                                      VerticalAlignment="Center">
                                                    <Button Grid.Column="0"
                                                            Grid.ColumnSpan="6"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Command="{ReflectionBinding $parent[UserControl].DataContext.EditScheduledPaymentCommand}"
                                                            CommandParameter="{Binding .}">
                                                        <Grid ColumnDefinitions="52,*,96,180,120,110"
                                                              ColumnSpacing="12"
                                                              VerticalAlignment="Center">
                                                            <Border Width="40"
                                                                    Height="40"
                                                                    CornerRadius="8"
                                                                    Background="White"
                                                                    BorderBrush="{DynamicResource Color.BorderSoft}"
                                                                    BorderThickness="1"
                                                                    BoxShadow="{DynamicResource Shadow.Card}">
                                                                <TextBlock Text="{Binding CategoryIcon}"
                                                                           FontFamily="{StaticResource EmojiFontFamily}"
                                                                           FontSize="18"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding DueDateDisplay}" Classes="muted" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Frequency}"
                                                                       Classes="muted"
                                                                       HorizontalAlignment="Left"
                                                                       TextAlignment="Left"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding DaysRemainingDisplay}"
                                                                       Foreground="{DynamicResource Color.Success}"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Left"
                                                                       TextAlignment="Left"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsDueFar}" />
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding DaysRemainingDisplay}"
                                                                       Foreground="#D1A100"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Left"
                                                                       TextAlignment="Left"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsDueLater}" />
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding DaysRemainingDisplay}"
                                                                       Foreground="{DynamicResource Color.Danger}"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Left"
                                                                       TextAlignment="Left"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsDueSoon}" />
                                                            <Border Grid.Column="4"
                                                                    Background="{Binding CategoryAnchorBrush}"
                                                                    CornerRadius="20"
                                                                    Padding="12,6"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Left"
                                                                    Width="{Binding $parent[UserControl].DataContext.ScheduledPaymentCategoryPillWidth}">
                                                                <TextBlock Text="{Binding CategoryDisplay}"
                                                                           HorizontalAlignment="Center"
                                                                           TextAlignment="Center"
                                                                           TextWrapping="Wrap"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <Grid Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding AmountWithSymbolDisplay}" Foreground="{DynamicResource Color.Success}" FontWeight="Bold" IsVisible="{Binding IsIncome}" />
                                                                <TextBlock Text="{Binding AmountWithSymbolDisplay}" Foreground="{DynamicResource Color.Danger}" FontWeight="Bold" IsVisible="{Binding !IsIncome}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <Border Classes="list-item-card"
                                                    Margin="0,2"
                                                    Background="{DynamicResource Color.DangerPanel}"
                                                    BorderBrush="{DynamicResource Color.Danger}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding IsOverdue}">
                                                <Grid ColumnDefinitions="52,*,96,180,120,110"
                                                      ColumnSpacing="12"
                                                      VerticalAlignment="Center">
                                                    <Button Grid.Column="0"
                                                            Grid.ColumnSpan="6"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Command="{ReflectionBinding $parent[UserControl].DataContext.EditScheduledPaymentCommand}"
                                                            CommandParameter="{Binding .}">
                                                        <Grid ColumnDefinitions="52,*,96,180,120,110"
                                                              ColumnSpacing="12"
                                                              VerticalAlignment="Center">
                                                            <Border Width="40"
                                                                    Height="40"
                                                                    CornerRadius="8"
                                                                    Background="White"
                                                                    BorderBrush="{DynamicResource Color.BorderSoft}"
                                                                    BorderThickness="1"
                                                                    BoxShadow="{DynamicResource Shadow.Card}">
                                                                <TextBlock Text="{Binding CategoryIcon}"
                                                                           FontFamily="{StaticResource EmojiFontFamily}"
                                                                           FontSize="18"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding DueDateDisplay}" Classes="muted" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Frequency}"
                                                                       Classes="muted"
                                                                       HorizontalAlignment="Left"
                                                                       TextAlignment="Left"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding DaysRemainingDisplay}"
                                                                       Foreground="{DynamicResource Color.Danger}"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Left"
                                                                       TextAlignment="Left"
                                                                       VerticalAlignment="Center" />
                                                            <Border Grid.Column="4"
                                                                    Background="{Binding CategoryAnchorBrush}"
                                                                    CornerRadius="20"
                                                                    Padding="12,6"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Left"
                                                                    Width="{Binding $parent[UserControl].DataContext.ScheduledPaymentCategoryPillWidth}">
                                                                <TextBlock Text="{Binding CategoryDisplay}"
                                                                           HorizontalAlignment="Center"
                                                                           TextAlignment="Center"
                                                                           TextWrapping="Wrap"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <Grid Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding AmountWithSymbolDisplay}" Foreground="{DynamicResource Color.Success}" FontWeight="Bold" IsVisible="{Binding IsIncome}" />
                                                                <TextBlock Text="{Binding AmountWithSymbolDisplay}" Foreground="{DynamicResource Color.Danger}" FontWeight="Bold" IsVisible="{Binding !IsIncome}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border IsVisible="{Binding IsScheduledPaymentConfirmDialogOpen}"
                    Background="{DynamicResource Color.Overlay}">
                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="440">
                    <Border Classes="dialog-card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding ScheduledPaymentConfirmTitle}"
                                       HorizontalAlignment="Center"
                                       FontSize="24"
                                       FontWeight="Bold" />

                            <TextBlock Text="{Binding Texts.ScheduledPaymentNameLabel}" Classes="form-label" />
                            <TextBlock Text="{Binding PendingScheduledPaymentConfirmation.Name}" FontWeight="SemiBold" />

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Texts.TransactionAmountLabel}" Classes="form-label" />
                                    <TextBlock Text="{Binding PendingScheduledPaymentConfirmation.AmountDisplay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding Texts.TransactionCurrencyLabel}" Classes="form-label" />
                                    <TextBlock Text="{Binding ScheduledPaymentConfirmCurrency}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding Texts.BankAccountsTitle}" Classes="form-label" />
                            <ComboBox ItemsSource="{Binding ScheduledPaymentConfirmAccounts}"
                                      SelectedItem="{Binding SelectedScheduledPaymentConfirmAccount}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BankAccountItemViewModel">
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Text="{Binding BalanceDisplay}" Classes="muted" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="8">
                                <Button Content="{Binding Texts.ConfirmScheduledPaymentButton}"
                                        Classes="primary-button"
                                        Command="{Binding ConfirmScheduledPaymentWithAccountCommand}" />
                                <Button Content="{Binding Texts.CancelButton}"
                                        Classes="secondary-button"
                                        Command="{Binding CloseScheduledPaymentConfirmDialogCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
