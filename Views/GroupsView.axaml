<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="720"
             x:Class="KeepWalletDesktop.Views.GroupsView"
             x:DataType="vm:MainViewModel">
    <Border Grid.Column="1" Margin="10" IsVisible="{Binding IsGroupsPage}">
        <Grid ColumnDefinitions="360, *" ColumnSpacing="14">
            <Border>
                <Grid RowDefinitions="Auto, *" RowSpacing="12">
                    <StackPanel Spacing="8">
                        <Border Classes="panel-card alt">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                    <Button Width="42"
                                            Height="42"
                                            Padding="0"
                                            Click="NewGroupIconButton_OnClick"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="{Binding NewGroupIconGlyph}"
                                                       FontFamily="Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji, sans-serif"
                                                       FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Image Source="{Binding NewGroupIconSampleImage}"
                                                   Width="28"
                                                   Height="28"
                                                   IsVisible="{Binding HasNewGroupIconSampleImage}" />
                                        </Grid>
                                    </Button>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NewGroupNameInput}"
                                             Watermark="{Binding Texts.GroupNameHint}" />
                                </Grid>
                                <Button Content="{Binding Texts.AddGroupButtonPlus}"
                                        HorizontalContentAlignment="Center"
                                        Classes="primary-button"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding AddGroupCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GroupItemViewModel">
                                <Button Margin="0,4"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.SelectGroupCommand}"
                                        CommandParameter="{Binding .}">
                                    <Grid>
                                        <Border IsVisible="{Binding IsActive}"
                                                BorderThickness="2"
                                                BorderBrush="{DynamicResource Color.Accent}"
                                                CornerRadius="{DynamicResource Radius.Card}" />
                                        <Border Classes="panel-card alt"
                                                Margin="3"
                                                HorizontalAlignment="Stretch"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource Color.BorderSoft}">
                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                                <Grid Width="42" Height="42" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding IconGlyph}"
                                                               FontFamily="Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji, sans-serif"
                                                               FontSize="18"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Image Source="{Binding IconSampleImage}"
                                                           Width="28"
                                                           Height="28"
                                                           IsVisible="{Binding HasIconSampleImage}" />
                                                </Grid>
                                                <Grid Grid.Column="1" RowDefinitions="Auto, Auto" RowSpacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding MemberCount}" Classes="muted" />
                                                        <TextBlock Text="{ReflectionBinding $parent[UserControl].DataContext.Texts.GroupMembersTitle}" Classes="muted" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                                    <Border Classes="owner-chip" IsVisible="{Binding IsOwnerRole}">
                                                        <TextBlock Text="{Binding RoleName}" />
                                                    </Border>
                                                    <Border Classes="member-chip" IsVisible="{Binding IsMemberRole}">
                                                        <TextBlock Text="{Binding RoleName}" />
                                                    </Border>
                                                    <Border Classes="viewer-chip" IsVisible="{Binding IsViewerRole}">
                                                        <TextBlock Text="{Binding RoleName}" />
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="panel-card">
                <Grid RowDefinitions="Auto, *" RowSpacing="14">
                    <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8">
                        <Button Width="52"
                                Height="52"
                                Padding="0"
                                Click="SelectedGroupIconButton_OnClick"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                            <Grid>
                                <TextBlock Text="{Binding SelectedAccessGroup.IconGlyph}"
                                           FontFamily="Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji, sans-serif"
                                           FontSize="22"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Image Source="{Binding SelectedAccessGroup.IconSampleImage}"
                                       Width="34"
                                       Height="34"
                                       IsVisible="{Binding SelectedAccessGroup.HasIconSampleImage}" />
                            </Grid>
                        </Button>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <Button Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalContentAlignment="Left"
                                    DoubleTapped="SelectedGroupName_OnDoubleTapped"
                                    IsVisible="{Binding !IsEditingSelectedGroupName}">
                                <TextBlock Text="{Binding SelectedAccessGroup.Name}"
                                           FontSize="22"
                                           FontWeight="SemiBold" />
                            </Button>
                            <TextBox Text="{Binding SelectedGroupNameInput}"
                                     FontSize="22"
                                     FontWeight="SemiBold"
                                     Width="260"
                                     HorizontalAlignment="Left"
                                     Watermark="{Binding Texts.GroupNameHint}"
                                     LostFocus="SelectedGroupNameTextBox_OnLostFocus"
                                     KeyDown="SelectedGroupNameTextBox_OnKeyDown"
                                     IsVisible="{Binding IsEditingSelectedGroupName}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding SelectedAccessGroup.CreatedAtDisplay}" Classes="muted" />
                                <Grid>
                                    <Border Classes="owner-chip" IsVisible="{Binding SelectedAccessGroup.IsOwnerRole}">
                                        <TextBlock Text="{Binding SelectedAccessGroup.RoleName}" />
                                    </Border>
                                    <Border Classes="member-chip" IsVisible="{Binding SelectedAccessGroup.IsMemberRole}">
                                        <TextBlock Text="{Binding SelectedAccessGroup.RoleName}" />
                                    </Border>
                                    <Border Classes="viewer-chip" IsVisible="{Binding SelectedAccessGroup.IsViewerRole}">
                                        <TextBlock Text="{Binding SelectedAccessGroup.RoleName}" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Width="44"
                                Height="44"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Classes="secondary-button"
                                Command="{Binding UpdateGroupCommand}">
                            <Viewbox Width="18" Height="18">
                                <TextBlock Text="&#xE34C;"
                                           FontFamily="{DynamicResource Phosphor-Fill}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Viewbox>
                        </Button>
                        <Button Grid.Column="3"
                                Width="44"
                                Height="44"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Classes="danger-button"
                                Command="{Binding DeleteGroupCommand}"
                                CommandParameter="{Binding SelectedAccessGroup}">
                            <Viewbox Width="18" Height="18">
                                <TextBlock Text="&#xE4A6;"
                                           FontFamily="{DynamicResource Phosphor-Fill}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Viewbox>
                        </Button>
                    </Grid>

                    <TabControl Grid.Row="1">
                        <TabItem Header="{Binding Texts.GroupMembersTitle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12" Margin="0,12,0,0">
                                    <Grid ColumnDefinitions="*, 150, Auto" ColumnSpacing="8">
                                        <ComboBox ItemsSource="{Binding GroupUserSearchResults}"
                                                  SelectedItem="{Binding SelectedGroupUser}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:UserListItemViewModel">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding GroupMemberCreateRoles}"
                                                  SelectedItem="{Binding SelectedGroupMemberRole}" />
                                        <Button Grid.Column="2"
                                                Content="{Binding Texts.AddUserButton}"
                                                Classes="primary-button"
                                                Command="{Binding AddGroupMemberCommand}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding SelectedGroupMembers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GroupMemberItemViewModel">
                                                <Border Classes="list-item-card" Margin="0,4">
                                                    <Grid ColumnDefinitions="2*, *, *, Auto, Auto" ColumnSpacing="8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding JoinedAtDisplay}" Classes="muted" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                DoubleTapped="GroupMemberRole_OnDoubleTapped"
                                                                IsVisible="{Binding !IsEditingRole}">
                                                            <TextBlock Text="{Binding RoleName}"
                                                                       VerticalAlignment="Center" />
                                                        </Button>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{ReflectionBinding $parent[UserControl].DataContext.GroupMemberRoles}"
                                                                  SelectedItem="{Binding SelectedRoleName}"
                                                                  SelectionChanged="GroupMemberRoleComboBox_OnSelectionChanged"
                                                                  IsVisible="{Binding IsEditingRole}" />
                                                        <Button Grid.Column="2"
                                                                Content="{ReflectionBinding $parent[UserControl].DataContext.Texts.TransferOwnerButton}"
                                                                Classes="secondary-button"
                                                                Command="{ReflectionBinding $parent[UserControl].DataContext.TransferGroupOwnerCommand}"
                                                                CommandParameter="{Binding .}" />
                                                        <Button Grid.Column="3"
                                                                Width="38"
                                                                Height="38"
                                                                Classes="secondary-button"
                                                                Command="{ReflectionBinding $parent[UserControl].DataContext.RemoveGroupMemberCommand}"
                                                                CommandParameter="{Binding .}">
                                                            <TextBlock Text="&#xE4A6;"
                                                                       FontFamily="{DynamicResource Phosphor-Fill}"
                                                                       FontSize="16" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="{Binding Texts.GroupAccessTitle}">
                            <StackPanel Spacing="14" Margin="0,12,0,0">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <ComboBox ItemsSource="{Binding BankAccounts}"
                                              SelectedItem="{Binding SelectedSharedBankAccount}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BankAccountItemViewModel">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1"
                                            Content="{Binding Texts.ShareAccountButton}"
                                            Classes="secondary-button"
                                            Command="{Binding ShareBankAccountWithGroupCommand}" />
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <ComboBox ItemsSource="{Binding Savings}"
                                              SelectedItem="{Binding SelectedSharedSaving}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SavingOptionViewModel">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1"
                                            Content="{Binding Texts.ShareSavingsButton}"
                                            Classes="secondary-button"
                                            Command="{Binding ShareSavingWithGroupCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding Texts.GroupAccessAccountsTitle}" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding SelectedGroupBankAccounts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BankAccountItemViewModel">
                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" Margin="0,3">
                                                <Button Classes="link-button"
                                                        HorizontalContentAlignment="Left"
                                                        Click="OpenGroupBankAccount_OnClick"
                                                        Content="{Binding Name}" />
                                                <Button Grid.Column="1"
                                                        Classes="secondary-button"
                                                        Click="OpenGroupBankAccount_OnClick"
                                                        Content="{Binding $parent[UserControl].DataContext.Texts.EditTransactionButton}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Texts.GroupAccessTransactionsTitle}" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding SelectedGroupTransactions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TransactionItemViewModel">
                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" Margin="0,3">
                                                <Button Classes="link-button"
                                                        HorizontalContentAlignment="Left"
                                                        Click="OpenGroupTransaction_OnClick"
                                                        Content="{Binding DescriptionDisplay}" />
                                                <Button Grid.Column="1"
                                                        Classes="secondary-button"
                                                        Click="OpenGroupTransaction_OnClick"
                                                        Content="{Binding $parent[UserControl].DataContext.Texts.EditTransactionButton}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Texts.GroupAccessSavingsTitle}" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding SelectedGroupSavings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SavingOptionViewModel">
                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" Margin="0,3">
                                                <Button Classes="link-button"
                                                        HorizontalContentAlignment="Left"
                                                        Click="OpenGroupSaving_OnClick"
                                                        Content="{Binding Name}" />
                                                <Button Grid.Column="1"
                                                        Classes="secondary-button"
                                                        Click="OpenGroupSaving_OnClick"
                                                        Content="{Binding $parent[UserControl].DataContext.Texts.EditTransactionButton}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
