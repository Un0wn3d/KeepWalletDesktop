<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="KeepWalletDesktop.Views.BankAccountsView"
             x:DataType="vm:MainViewModel">
        <Border Grid.Column="1" Margin="10, 10, 10, 10" IsVisible="{Binding IsBankAccountsPage}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="{Binding Texts.BankAccountsTitle}"
                                   Classes="page-title" />
                        <Button Grid.Column="1"
                                Content="{Binding Texts.NewBankAccountButton}"
                                Classes="primary-button"
                                Command="{Binding BeginCreateBankAccountCommand}" />
                    </Grid>
                    <Border Classes="panel-card alt">
                        <Grid>
                            <TextBlock Text="{Binding Texts.BankAccountsUnavailableText}"
                                       IsVisible="{Binding HasNoBankAccounts}" />
                            <ItemsControl ItemsSource="{Binding BankAccounts}"
                                          IsVisible="{Binding HasBankAccounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BankAccountItemViewModel">
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" Margin="0,6">
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.SelectBankAccountCommand}"
                                                    CommandParameter="{Binding .}">
                                                <Grid ColumnDefinitions="220, Auto, *, Auto" ColumnSpacing="8">
                                                    <StackPanel VerticalAlignment="Center"
                                                                ClipToBounds="True">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource Color.Text1}" />
                                                        <TextBlock Text="{Binding Currency}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Classes="muted" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Background="{Binding GroupBrush}"
                                                            CornerRadius="20"
                                                            Padding="12,6"
                                                            MinWidth="{ReflectionBinding $parent[UserControl].DataContext.BankAccountGroupPillWidth}"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Left"
                                                            IsVisible="{Binding IsShared}">
                                                        <TextBlock Text="{Binding OwnerDisplayText}"
                                                                   HorizontalAlignment="Center"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding BalanceDisplay}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Color.Text1}" />
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Width="44"
                                                    Height="44"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Classes="secondary-button"
                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.EditBankAccountCommand}"
                                                    CommandParameter="{Binding .}">
                                                <Viewbox Width="18" Height="18">
                                                    <TextBlock Text="&#xE34C;"
                                                               FontFamily="{DynamicResource Phosphor-Fill}"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
</UserControl>
