<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KeepWalletDesktop.ViewModels"
        xmlns:views="clr-namespace:KeepWalletDesktop.Views"
        xmlns:controls="clr-namespace:KeepWalletDesktop.Views.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        MinWidth="900"
        MinHeight="720"
        x:Class="KeepWalletDesktop.Views.MainView"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/cardholder.ico"
        Title="KeepWalletDesktop"
        Background="{DynamicResource Color.Background}">
    <Grid>
        <views:AuthView IsVisible="{Binding IsAuthPage}" />
        <views:AppShellView IsVisible="{Binding CanOpenAppPages}" />

        <controls:OnboardingDialog />
    </Grid>
</Window>
