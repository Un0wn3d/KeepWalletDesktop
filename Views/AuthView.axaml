<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="KeepWalletDesktop.Views.AuthView"
             x:DataType="vm:MainViewModel">
    <Border Margin="24"
            Background="{DynamicResource Color.Background}">
        <Grid>
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="520"
                  RowDefinitions="Auto, Auto, Auto, Auto"
                  RowSpacing="18">
                <StackPanel Spacing="6"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Texts.WelcomeText}"
                               HorizontalAlignment="Center"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Color.Text1}" />
                    <!-- <TextBlock Text="{Binding Texts.AuthSubtitle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" /> -->
                </StackPanel>

                <Border Grid.Row="1"
                        Classes="auth-card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding AuthCardTitle}"
                                   HorizontalAlignment="Center"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Color.Text1}" />

                        <StackPanel Orientation="Horizontal"
                                    Spacing="2"
                                    IsVisible="{Binding IsLoginMode}">
                            <TextBlock Text="{Binding Texts.LoginOrEmailLabel}" />
                        </StackPanel>
                        <TextBox Text="{Binding ApiLogin}"
                                 IsVisible="{Binding IsLoginMode}"
                                 Watermark="alex" />

                        <StackPanel Orientation="Horizontal"
                                    Spacing="2"
                                    IsVisible="{Binding IsLoginMode}">
                            <TextBlock Text="{Binding Texts.PasswordLabel}" />
                        </StackPanel>
                        <TextBox Text="{Binding ApiPassword}"
                                 IsVisible="{Binding IsLoginMode}"
                                 PasswordChar="*"
                                 Watermark="password" />

                        <Button Content="{Binding Texts.LoginButton}"
                                Classes="auth-submit-button"
                                IsVisible="{Binding IsLoginMode}"
                                Command="{Binding LoginToApiCommand}" />

                        <StackPanel Orientation="Horizontal"
                                    Spacing="2"
                                    IsVisible="{Binding IsRegisterMode}">
                            <TextBlock Text="{Binding Texts.UsernameLabel}" />
                            <TextBlock Text="*" />
                        </StackPanel>
                        <TextBox Text="{Binding RegisterUsername}"
                                 IsVisible="{Binding IsRegisterMode}"
                                 Watermark="alex" />

                        <StackPanel Orientation="Horizontal"
                                    Spacing="2"
                                    IsVisible="{Binding IsRegisterMode}">
                            <TextBlock Text="{Binding Texts.EmailLabel}" />
                            <TextBlock Text="*" />
                        </StackPanel>
                        <TextBox Text="{Binding RegisterEmail}"
                                 IsVisible="{Binding IsRegisterMode}"
                                 Watermark="alex@example.com" />

                        <StackPanel Orientation="Horizontal"
                                    Spacing="2"
                                    IsVisible="{Binding IsRegisterMode}">
                            <TextBlock Text="{Binding Texts.PasswordLabel}" />
                            <TextBlock Text="*" />
                        </StackPanel>
                        <TextBox Text="{Binding RegisterPassword}"
                                 IsVisible="{Binding IsRegisterMode}"
                                 PasswordChar="*"
                                 Watermark="password" />

                        <TextBlock Text="{Binding Texts.FullNameLabel}"
                                   IsVisible="{Binding IsRegisterMode}" />
                        <TextBox Text="{Binding RegisterFullName}"
                                 IsVisible="{Binding IsRegisterMode}"
                                 Watermark="Alex Example" />

                        <Button Content="{Binding Texts.RegisterButton}"
                                Classes="auth-submit-button"
                                IsVisible="{Binding IsRegisterMode}"
                                Command="{Binding RegisterInApiCommand}" />

                        <TextBlock Text="{Binding ApiStatusMessage}"
                                   Classes="status-text" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="6">
                            <Button Content="{Binding AuthFooterAction}"
                                    Classes="link-button"
                                    Command="{Binding ToggleAuthModeCommand}" />
                        </StackPanel>
                    </StackPanel>
                        </Border>

                <Button Grid.Row="2"
                        HorizontalAlignment="Center"
                        Classes="link-button"
                        Content="{Binding ApiBaseUrl}"
                        Command="{Binding OpenServerDialogCommand}" />

                <StackPanel Grid.Row="3"
                            HorizontalAlignment="Center"
                            Spacing="6">
                    <TextBlock Text="{Binding Texts.LanguageLabel}"
                               HorizontalAlignment="Center" />
                    <ComboBox Width="220"
                              HorizontalAlignment="Center"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguage}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LanguageOptionViewModel">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Border IsVisible="{Binding IsServerDialogOpen}"
                    Background="{DynamicResource Color.Overlay}">
                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="420">
                    <Border Classes="dialog-card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding Texts.ServerSettingsTitle}"
                                       HorizontalAlignment="Center"
                                       FontSize="22"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding Texts.ServerHostLabel}" />
                            <TextBox Text="{Binding ServerHost}" />
                            <TextBlock Text="{Binding Texts.ServerPortLabel}" />
                            <TextBox Text="{Binding ServerPort}" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="8">
                                <Button Content="{Binding Texts.CancelButton}"
                                        Command="{Binding CloseServerDialogCommand}" />
                                <Button Content="{Binding Texts.SaveServerSettingsButton}"
                                        Command="{Binding SaveServerSettingsCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
