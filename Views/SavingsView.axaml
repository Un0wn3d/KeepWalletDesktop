<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="KeepWalletDesktop.Views.SavingsView"
             x:DataType="vm:MainViewModel">
        <Border Grid.Column="1" Margin="10, 10, 10, 10" IsVisible="{Binding IsPiggyBankPage}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="10">
                    <TextBlock Text="{Binding Texts.PiggyBankTitle}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Color.Text1}" />

                    <Border Grid.Row="1" Classes="panel-card">
                        <Grid RowDefinitions="Auto, Auto" RowSpacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{Binding Texts.PiggyBankTitle}"
                                           Classes="card-title" />
                                <Button Grid.Column="1"
                                        Content="{Binding Texts.CreatePiggyBankButton}"
                                        Command="{Binding CreateNewPiggyBankCommand}" />
                            </Grid>

                            <Grid Grid.Row="1" RowDefinitions="Auto, Auto" RowSpacing="12">
                                <ItemsControl ItemsSource="{Binding Savings}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SavingOptionViewModel">
                                            <Button Command="{ReflectionBinding $parent[UserControl].DataContext.SelectSavingCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Margin="0,0,8,8">
                                                <Grid Width="180"
                                                      MinHeight="92"
                                                      RowDefinitions="*, Auto"
                                                      Background="{DynamicResource Color.SurfaceOverlay}"
                                                      ClipToBounds="True">
                                                    <Grid.Styles>
                                                        <Style Selector="Grid">
                                                            <Setter Property="Margin" Value="0" />
                                                        </Style>
                                                    </Grid.Styles>
                                                    <Border BorderBrush="{DynamicResource Color.BorderSoft}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="10">
                                                        <Grid RowDefinitions="Auto, *, Auto">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Grid.Row="2"
                                                                       Text="{Binding AmountDisplay}"
                                                                       FontSize="18"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource Color.Text1}" />
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Grid.Row="1" RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="10">
                                <Grid ColumnDefinitions="2*, *" ColumnSpacing="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Texts.SavingNameLabel}" />
                                        <TextBox Text="{Binding SavingNameInput}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Texts.GoalAmountLabel}" />
                                        <TextBox Watermark="{Binding Texts.GoalAmountHint}" Text="{Binding GoalAmount}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Texts.SavingsAmountLabel}" />
                                        <TextBox Watermark="{Binding Texts.SavingsAmountHint}" Text="{Binding AddAmount}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                        <Button Content="{Binding Texts.SaveGoalButton}"
                                                Command="{Binding SaveGoalCommand}" />
                                        <Button Content="{Binding Texts.AddToSavingsButton}"
                                                Command="{Binding AddToSavingsCommand}" />
                                        <Button Content="{Binding Texts.DeleteTransactionButton}"
                                                Classes="secondary-button"
                                                Command="{Binding DeleteActiveSavingCommand}" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="2" Classes="panel-card alt">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Texts.GoalProgressLabel}" Foreground="{DynamicResource Color.Text1}" />
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
                                        <TextBlock Text="{Binding SavedAmountDisplay}" />
                                        <TextBlock Text="{Binding RemainingAmountDisplay}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Row="3"
                                           Text="{Binding PiggyBankStatusMessage}"
                                           TextWrapping="Wrap"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Color.Success}" />
                            </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Classes="panel-card">
                        <Grid RowDefinitions="Auto, Auto" RowSpacing="8">
                            <TextBlock Text="{Binding Texts.SavingItemsTitle}"
                                       Classes="card-title" />
                            <Grid Grid.Row="1" ColumnDefinitions="2*, *, Auto" ColumnSpacing="8">
                                <TextBox Watermark="{Binding Texts.SavingItemNameHint}" Text="{Binding SavingItemNameInput}" />
                                <TextBox Grid.Column="1" Watermark="{Binding Texts.SavingItemAmountHint}" Text="{Binding SavingItemAmount}" />
                                <Button Grid.Column="2"
                                        Content="{Binding Texts.AddSavingItemButton}"
                                        Command="{Binding AddSavingItemCommand}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <ItemsControl Grid.Row="3" ItemsSource="{Binding SavingItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SavingItemViewModel">
                                <Border Classes="list-item-card">
                                    <Grid ColumnDefinitions="Auto, *, 160, Auto, Auto" ColumnSpacing="10">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="4"
                                                    VerticalAlignment="Center">
                                            <Button Content="Up"
                                                    Classes="secondary-button"
                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.MoveSavingItemUpCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Content="Down"
                                                    Classes="secondary-button"
                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.MoveSavingItemDownCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" />
                                            <ProgressBar Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding ProgressPercent}"
                                                         Height="8" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ProgressDisplay}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="{Binding AmountDisplay}" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="4"
                                                  IsChecked="{Binding IsPaid, Mode=OneWay}"
                                                  Command="{ReflectionBinding $parent[UserControl].DataContext.ToggleSavingItemCommand}"
                                                  CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Grid>
            </ScrollViewer>
        </Border>
</UserControl>
