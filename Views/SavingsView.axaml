<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="KeepWalletDesktop.Views.SavingsView"
             x:DataType="vm:MainViewModel">
        <Border Grid.Column="1" Margin="16" IsVisible="{Binding IsPiggyBankPage}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="16" MaxWidth="1180">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="{Binding Texts.PiggyBankTitle}"
                                   Classes="page-title" />
                        <Button Grid.Column="1"
                                Content="{Binding Texts.CreatePiggyBankButton}"
                                Classes="primary-button"
                                Command="{Binding CreateNewPiggyBankCommand}" />
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Savings}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SavingOptionViewModel">
                                <Button Command="{ReflectionBinding $parent[UserControl].DataContext.SelectSavingCommand}"
                                        CommandParameter="{Binding .}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,0,12,12">
                                    <Border Width="220"
                                            MinHeight="112"
                                            Background="{DynamicResource Color.Surface}"
                                            BorderBrush="{DynamicResource Color.BorderSoft}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="18"
                                            BoxShadow="{DynamicResource Shadow.Card}">
                                        <Grid RowDefinitions="Auto, *, Auto" RowSpacing="8">
                                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                                                <Border Width="34"
                                                        Height="34"
                                                        CornerRadius="17"
                                                        Background="{DynamicResource Color.AccentSoft}">
                                                    <TextBlock Text="$"
                                                               Foreground="{DynamicResource Color.Accent}"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding AmountDisplay}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Color.Text1}" />
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="2"
                            Background="{DynamicResource Color.Surface}"
                            BorderBrush="{DynamicResource Color.BorderSoft}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="24"
                            BoxShadow="{DynamicResource Shadow.Card}">
                        <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="18">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16">
                                <Border Width="56"
                                        Height="56"
                                        CornerRadius="28"
                                        Background="{DynamicResource Color.SuccessPanel}">
                                    <TextBlock Text="$"
                                               Foreground="White"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding SavingNameInput}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Color.Text1}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SavedAmountDisplay}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Color.Text1}" />
                                    <TextBlock Text="{Binding RemainingAmountDisplay}"
                                               FontSize="14"
                                               Foreground="{DynamicResource Color.TextMuted}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Color.TextMuted}"
                                           VerticalAlignment="Top" />
                            </Grid>

                            <ProgressBar Grid.Row="1"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ProgressPercent}"
                                         Height="18"
                                         CornerRadius="9"
                                         Foreground="{DynamicResource Color.Success}"
                                         Background="{DynamicResource Color.SurfaceAlt}" />

                            <Grid Grid.Row="2" ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                <TextBox Watermark="{Binding Texts.SavingsAmountHint}"
                                         Text="{Binding AddAmount}"
                                         MinHeight="42" />
                                <Button Grid.Column="1"
                                        Content="{Binding Texts.AddToSavingsButton}"
                                        Classes="primary-button"
                                        MinWidth="140"
                                        Command="{Binding AddToSavingsCommand}" />
                            </Grid>

                            <Expander Grid.Row="3" Header="⚙">
                                <Grid RowDefinitions="Auto, Auto" RowSpacing="12" Margin="0,12,0,0">
                                    <Grid ColumnDefinitions="2*, *" ColumnSpacing="12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Texts.SavingNameLabel}"
                                                       Classes="form-label" />
                                            <TextBox Text="{Binding SavingNameInput}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Texts.GoalAmountLabel}"
                                                       Classes="form-label" />
                                            <TextBox Watermark="{Binding Texts.GoalAmountHint}"
                                                     Text="{Binding GoalAmount}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="1"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                HorizontalAlignment="Right">
                                        <Button Content="{Binding Texts.SaveGoalButton}"
                                                Command="{Binding SaveGoalCommand}" />
                                        <Button Content="{Binding Texts.DeleteTransactionButton}"
                                                Classes="secondary-button"
                                                Command="{Binding DeleteActiveSavingCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Expander>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Background="{DynamicResource Color.Surface}"
                            BorderBrush="{DynamicResource Color.BorderSoft}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="24"
                            BoxShadow="{DynamicResource Shadow.Card}">
                        <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="14">
                            <TextBlock Text="{Binding Texts.SavingItemsTitle}"
                                       Classes="card-title" />

                            <Grid Grid.Row="1" ColumnDefinitions="2*, *, Auto" ColumnSpacing="8">
                                <TextBox Watermark="{Binding Texts.SavingItemNameHint}"
                                         Text="{Binding SavingItemNameInput}" />
                                <TextBox Grid.Column="1"
                                         Watermark="{Binding Texts.SavingItemAmountHint}"
                                         Text="{Binding SavingItemAmount}" />
                                <Button Grid.Column="2"
                                        Content="{Binding Texts.AddSavingItemButton}"
                                        Classes="primary-button"
                                        Command="{Binding AddSavingItemCommand}" />
                            </Grid>

                            <TextBlock Grid.Row="2"
                                       Text="{Binding PiggyBankStatusMessage}"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Color.Success}" />

                            <ItemsControl Grid.Row="3" ItemsSource="{Binding SavingItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SavingItemViewModel">
                                        <Border Padding="0,12"
                                                BorderBrush="{DynamicResource Color.BorderSoft}"
                                                BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="Auto, *, Auto, Auto"
                                                  ColumnSpacing="12">
                                                <CheckBox IsChecked="{Binding IsPaid, Mode=OneWay}"
                                                          VerticalAlignment="Center"
                                                          Command="{ReflectionBinding $parent[UserControl].DataContext.ToggleSavingItemCommand}"
                                                          CommandParameter="{Binding .}" />
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Spacing="2">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding ProgressDisplay}"
                                                               Classes="muted" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding AmountDisplay}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="3"
                                                            Orientation="Horizontal"
                                                            Spacing="4"
                                                            VerticalAlignment="Center">
                                                    <Button Content="↑"
                                                            Classes="secondary-button"
                                                            Padding="8,4"
                                                            Command="{ReflectionBinding $parent[UserControl].DataContext.MoveSavingItemUpCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    <Button Content="↓"
                                                            Classes="secondary-button"
                                                            Padding="8,4"
                                                            Command="{ReflectionBinding $parent[UserControl].DataContext.MoveSavingItemDownCommand}"
                                                            CommandParameter="{Binding .}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>
</UserControl>
