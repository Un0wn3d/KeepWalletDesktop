<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="720"
             x:Class="KeepWalletDesktop.Views.SavingsView"
             x:DataType="vm:MainViewModel">
    <Grid Grid.Column="1" Margin="10">
        <Grid ColumnDefinitions="360, *" ColumnSpacing="14">
            <Border>
                <Grid RowDefinitions="Auto, *" RowSpacing="12">
                    <Border Classes="panel-card alt">
                        <StackPanel Spacing="10">
                            <Button Content="{Binding Texts.CreateSavingsButton}"
                                    HorizontalContentAlignment="Center"
                                    Classes="primary-button"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding CreateNewSavingsCommand}" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Savings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SavingOptionViewModel">
                                    <Button Margin="0,4"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{ReflectionBinding $parent[UserControl].DataContext.SelectSavingCommand}"
                                            CommandParameter="{Binding .}">
                                        <Grid>
                                            <Border IsVisible="{Binding IsSelected}"
                                                    BorderThickness="2"
                                                    BorderBrush="{DynamicResource Color.Accent}"
                                                    CornerRadius="{DynamicResource Radius.Card}" />
                                            <Border Classes="panel-card alt"
                                                    Margin="3"
                                                    HorizontalAlignment="Stretch"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource Color.BorderSoft}">
                                                <Grid RowDefinitions="Auto, Auto"
                                                      RowSpacing="8">
                                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                                        <Border Width="42"
                                                                Height="42"
                                                                CornerRadius="21"
                                                                Background="{Binding AccentBrush}">
                                                            <TextBlock Text="{Binding IconGlyph}"
                                                                       FontFamily="{StaticResource EmojiFontFamily}"
                                                                       FontSize="20"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1"
                                                                    Spacing="4"
                                                                    VerticalAlignment="Center">
                                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding DeadlineDisplay}"
                                                                           Classes="muted"
                                                                           FontSize="11"
                                                                           VerticalAlignment="Center" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="5">
                                                                <TextBlock Text="{Binding AmountDisplay}"
                                                                           Classes="muted"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="/"
                                                                           Classes="muted" />
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding TargetAmountDisplay}"
                                                                           Classes="muted" />
                                                            </Grid>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding ProgressDisplay}"
                                                                   Classes="muted"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>

                                                    <ProgressBar Grid.Row="1"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Value="{Binding ProgressPercent}"
                                                                 Height="8"
                                                                 CornerRadius="4"
                                                                 Foreground="{Binding AccentBrush}"
                                                                 Background="#D1D5DB" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="panel-card">
                <Grid>
                <Grid RowDefinitions="Auto, Auto, *" RowSpacing="14"
                      IsVisible="{Binding HasSavings}">
                    <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto" ColumnSpacing="8">
                        <Button Width="52"
                                Height="52"
                                Padding="0"
                                BorderThickness="0"
                                Background="{Binding ActiveSavingColorBrush}"
                                CornerRadius="26"
                                Click="ActiveSavingIcon_OnClick"
                                DoubleTapped="ActiveSavingIcon_OnDoubleTapped">
                            <TextBlock Text="{Binding ActiveSavingIconGlyph}"
                                       FontFamily="{StaticResource EmojiFontFamily}"
                                       FontSize="24"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="4">
                                <Button Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        DoubleTapped="SavingName_OnDoubleTapped"
                                        IsVisible="{Binding !IsEditingSavingNameField}">
                                    <TextBlock Text="{Binding SavingNameInput}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Color.Text1}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" />
                                </Button>
                                <TextBox Text="{Binding SavingNameEditInput}"
                                         FontSize="22"
                                         FontWeight="SemiBold"
                                         LostFocus="SavingNameEditTextBox_OnLostFocus"
                                         IsVisible="{Binding IsEditingSavingNameField}" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding ActiveSavingDeadlineDisplay}"
                                           Classes="muted"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           DoubleTapped="SavingDeadline_OnDoubleTapped"
                                           IsVisible="{Binding !IsEditingSavingDeadlineField}" />
                                <CalendarDatePicker Grid.Column="1"
                                                    SelectedDate="{Binding SavingDeadlineEditDate, Mode=TwoWay}"
                                                    IsVisible="{Binding IsEditingSavingDeadlineField}" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, Auto" ColumnSpacing="4">
                                <TextBlock Text="{Binding SavedAmountDisplay}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Color.Text1}"
                                           TextWrapping="Wrap"
                                           DoubleTapped="SavingCurrent_OnDoubleTapped"
                                           IsVisible="{Binding !IsEditingSavingCurrentField}" />
                                <TextBox Text="{Binding SavingCurrentAmountEditInput}"
                                         Width="120"
                                         HorizontalAlignment="Left"
                                         LostFocus="SavingCurrentEditTextBox_OnLostFocus"
                                         IsVisible="{Binding IsEditingSavingCurrentField}" />

                                <TextBlock Grid.Column="1" Text="/" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Color.Text1}" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding SavingGoalAmountEditInput}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Color.Text1}"
                                           TextWrapping="Wrap"
                                           DoubleTapped="SavingGoal_OnDoubleTapped"
                                           IsVisible="{Binding !IsEditingSavingGoalField}" />
                                <TextBox Grid.Column="2"
                                         Text="{Binding SavingGoalAmountEditInput}"
                                         Width="120"
                                         HorizontalAlignment="Left"
                                         LostFocus="SavingGoalEditTextBox_OnLostFocus"
                                         IsVisible="{Binding IsEditingSavingGoalField}" />

                                <TextBlock Grid.Column="3"
                                           Text="{Binding ActiveSavingCurrency}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Color.Text1}"
                                           DoubleTapped="SavingCurrency_OnDoubleTapped"
                                           IsVisible="{Binding !IsEditingSavingCurrencyField}" />
                                <ComboBox Grid.Column="3"
                                          Width="92"
                                          ItemsSource="{Binding OnboardingCurrencyOptions}"
                                          SelectedItem="{Binding SavingCurrencyEditInput}"
                                          SelectionChanged="SavingCurrencyComboBox_OnSelectionChanged"
                                          IsVisible="{Binding IsEditingSavingCurrencyField}" />
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Color.Text1}"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="3"
                                Width="44"
                                Height="44"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Classes="secondary-button"
                                Command="{Binding SaveGoalCommand}">
                            <Viewbox Width="18" Height="18">
                                <TextBlock Text="&#xE34C;"
                                           FontFamily="{DynamicResource Phosphor-Fill}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Viewbox>
                        </Button>
                        <Button Grid.Column="4"
                                Width="44"
                                Height="44"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Classes="danger-button"
                                Command="{Binding DeleteActiveSavingCommand}">
                            <Viewbox Width="18" Height="18">
                                <TextBlock Text="&#xE4A6;"
                                           FontFamily="{DynamicResource Phosphor-Fill}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Viewbox>
                        </Button>
                    </Grid>

                    <ProgressBar Grid.Row="1"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent}"
                                 Height="18"
                                 CornerRadius="9"
                                 Foreground="{Binding ActiveSavingColorBrush}"
                                 Background="#D1D5DB" />

                    <TabControl Grid.Row="2">
                        <TabItem Header="{Binding Texts.SavingsTitle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="14" Margin="0,12,0,0">
                                    <Grid ColumnDefinitions="*, 240, Auto, Auto" ColumnSpacing="12">
                                        <TextBox Watermark="{Binding Texts.SavingsAmountHint}"
                                                 Text="{Binding AddAmount}"
                                                 MinHeight="42" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding CompatibleSavingsBankAccounts}"
                                                  SelectedItem="{Binding SelectedSavingsBankAccount}"
                                                  MinHeight="42">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:BankAccountItemViewModel">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="2"
                                                Content="{Binding Texts.AddToSavingsButton}"
                                                Classes="primary-button"
                                                MinWidth="120"
                                                Command="{Binding AddToSavingsCommand}" />
                                        <Button Grid.Column="3"
                                                Content="{Binding Texts.WithdrawFromSavingsButton}"
                                                Classes="secondary-button"
                                                MinWidth="120"
                                                Command="{Binding WithdrawFromSavingsCommand}" />
                                    </Grid>

                                    <Border Classes="panel-card alt">
                                        <Grid RowDefinitions="Auto, Auto, *" RowSpacing="10">
                                            <TextBlock Text="{Binding Texts.TransactionsSectionTitle}"
                                                       Classes="card-title" />
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Texts.NoTransactionsText}"
                                                       IsVisible="{Binding HasNoSavingTransactions}" />

                                            <ItemsControl Grid.Row="2"
                                                          ItemsSource="{Binding SavingTransactions}"
                                                          IsVisible="{Binding HasSavingTransactions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TransactionItemViewModel">
                                                        <Border Classes="list-item-card" Margin="0,4">
                                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                                                <Border Width="36"
                                                                        Height="36"
                                                                        CornerRadius="8"
                                                                        Background="White"
                                                                        BorderBrush="{DynamicResource Color.BorderSoft}"
                                                                        BorderThickness="1"
                                                                        BoxShadow="{DynamicResource Shadow.Card}">
                                                                    <TextBlock Text="{Binding CategoryIcon}"
                                                                               FontFamily="{StaticResource EmojiFontFamily}"
                                                                               FontSize="16"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Spacing="2">
                                                                    <TextBlock Text="{Binding DescriptionDisplay}"
                                                                               FontWeight="SemiBold"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding TransactionDateDisplay}"
                                                                               Classes="muted" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding ReversedAmountDisplay}"
                                                                           FontWeight="Bold"
                                                                           TextAlignment="Right"
                                                                           TextWrapping="Wrap"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource Color.Text1}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="{Binding Texts.SavingItemsTitle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12" Margin="0,12,0,0">
                                    <StackPanel.Styles>
                                        <Style Selector="CheckBox:disabled">
                                            <Setter Property="Opacity" Value="1" />
                                        </Style>
                                        <Style Selector="CheckBox:disabled /template/ Border#NormalRectangle">
                                            <Setter Property="Background" Value="#D1D5DB" />
                                            <Setter Property="BorderBrush" Value="#9CA3AF" />
                                        </Style>
                                        <Style Selector="CheckBox.saving-checkbox-insufficient /template/ Border#NormalRectangle">
                                            <Setter Property="Background" Value="#D1D5DB" />
                                            <Setter Property="BorderBrush" Value="#9CA3AF" />
                                        </Style>
                                    </StackPanel.Styles>
                                    <Grid ColumnDefinitions="2*, *, Auto" ColumnSpacing="8">
                                        <TextBox Watermark="{Binding Texts.SavingItemNameHint}"
                                                 Text="{Binding SavingItemNameInput}" />
                                        <TextBox Grid.Column="1"
                                                 Watermark="{Binding Texts.SavingItemAmountHint}"
                                                 Text="{Binding SavingItemAmount}" />
                                        <Button Grid.Column="2"
                                                Content="{Binding Texts.AddSavingItemButton}"
                                                Classes="primary-button"
                                                Command="{Binding AddSavingItemCommand}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding SavingItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SavingItemViewModel">
                                                <Border Classes="list-item-card" Margin="0,4">
                                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto"
                                                          ColumnSpacing="12">
                                                        <Grid>
                                                            <CheckBox IsChecked="{Binding IsPaid, Mode=OneWay}"
                                                                      IsVisible="{Binding IsFullyFunded}"
                                                                      VerticalAlignment="Center"
                                                                      Command="{ReflectionBinding $parent[UserControl].DataContext.ToggleSavingItemCommand}"
                                                                      CommandParameter="{Binding .}" />
                                                            <CheckBox IsChecked="{Binding IsPaid, Mode=OneWay}"
                                                                      IsVisible="{Binding !IsFullyFunded}"
                                                                      Classes="saving-checkbox-insufficient"
                                                                      VerticalAlignment="Center"
                                                                      Command="{ReflectionBinding $parent[UserControl].DataContext.ToggleSavingItemCommand}"
                                                                      CommandParameter="{Binding .}" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Spacing="2">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding ProgressDisplay}"
                                                                       Classes="muted" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding AmountDisplay}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="3"
                                                                    Orientation="Horizontal"
                                                                    Spacing="4"
                                                                    VerticalAlignment="Center">
                                                            <Button Content="&#x2191;"
                                                                    Classes="secondary-button"
                                                                    Padding="8,4"
                                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.MoveSavingItemUpCommand}"
                                                                    CommandParameter="{Binding .}" />
                                                            <Button Content="&#x2193;"
                                                                    Classes="secondary-button"
                                                                    Padding="8,4"
                                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.MoveSavingItemDownCommand}"
                                                                    CommandParameter="{Binding .}" />
                                                            <Button Content="&#x00D7;"
                                                                    Classes="danger-button"
                                                                    Padding="8,4"
                                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.DeleteSavingItemCommand}"
                                                                    CommandParameter="{Binding .}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
                <StackPanel IsVisible="{Binding HasNoSavings}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="14">
                    <TextBlock Text="{Binding Texts.NoSavingsText}"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <Button Content="{Binding Texts.CreateSavingsButton}"
                            Classes="primary-button"
                            HorizontalAlignment="Center"
                            Command="{Binding CreateNewSavingsCommand}" />
                </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
