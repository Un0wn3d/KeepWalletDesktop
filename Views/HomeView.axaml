<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:modules="using:KeepWalletDesktop.Views.Modules"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="KeepWalletDesktop.Views.HomeView"
             x:DataType="vm:MainViewModel">
        <Border Grid.Column="1" Margin="16" IsVisible="{Binding IsHomePage}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          ScrollChanged="HomeScrollViewer_OnScrollChanged">
                <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="16" MaxWidth="1280">
                    <Border Grid.Row="0">
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="16">
                            <Border Grid.Column="0" Classes="metric-card total">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Foreground="White" Text="{Binding Texts.Total}" FontSize="12" />
                                        <TextBlock Foreground="White"
                                               Text="{Binding Money}"
                                               Classes="amount-text"
                                               FontSize="36"
                                               FontWeight="Bold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Classes="metric-card income">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Foreground="White" Text="{Binding Texts.Income}" FontSize="12" />
                                        <TextBlock Foreground="White"
                                               Text="{Binding Income}"
                                               Classes="amount-text"
                                               FontSize="36"
                                               FontWeight="Bold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Classes="metric-card expense">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Foreground="White" Text="{Binding Texts.Expenses}" FontSize="12" />
                                        <TextBlock Foreground="White"
                                               Text="{Binding Expense}"
                                               Classes="amount-text"
                                               FontSize="36"
                                               FontWeight="Bold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" MinHeight="{Binding HomeChartPanelHeight}">
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                            <Button Grid.Column="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    MinHeight="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Command="{Binding OpenCategoryDetailsCommand}">
                                <Border Classes="panel-card alt"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <Grid RowDefinitions="Auto, *" RowSpacing="12">
                                        <TextBlock Foreground="{DynamicResource Color.Text1}"
                                                   Text="{Binding Texts.TransactionBreakdownTitle}"
                                                   Classes="section-title" />
                                        <Grid Grid.Row="1" ColumnDefinitions="*, 220" ColumnSpacing="10">
                                            <lvc:PieChart x:Name="ExpensePieChart"
                                                          Grid.Column="0"
                                                          Background="{DynamicResource Color.SurfaceAlt}"
                                                          LegendPosition="Hidden"
                                                          Series="{Binding Series}" />
                                            <ItemsControl Grid.Column="1"
                                                          ItemsSource="{Binding ExpenseCategoryLegend}"
                                                          IsVisible="{Binding HasExpenseTransactions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CategoryLegendItemViewModel">
                                                        <Grid ColumnDefinitions="14, *, Auto"
                                                              ColumnSpacing="8"
                                                              Margin="0,4">
                                                            <Border Width="10"
                                                                    Height="10"
                                                                    CornerRadius="5"
                                                                    Background="{Binding ColorBrush}"
                                                                    VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Name}"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding AmountDisplay}"
                                                                       Classes="muted"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Texts.ChartNoDataText}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding HasNoExpenseTransactions}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Button>
                            <Border Grid.Column="1" Classes="panel-card alt">
                                <Grid RowDefinitions="Auto, *" RowSpacing="12">
                                    <TextBlock Foreground="{DynamicResource Color.Text1}"
                                               Text="{Binding TransactionTimelineTitle}"
                                               Classes="section-title" />
                                    <Grid Grid.Row="1">
                                        <lvc:CartesianChart x:Name="TimelineChart"
                                                            Background="{DynamicResource Color.SurfaceAlt}"
                                                            Series="{Binding Chart}"
                                                            XAxes="{Binding TransactionTimelineXAxes}"
                                                            YAxes="{Binding TransactionTimelineYAxes}"
                                                            ZoomMode="X" />
                                        <TextBlock Text="{Binding Texts.ChartNoDataText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding HasNoTransactions}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <modules:DateSortModuleView Grid.Row="2" HorizontalAlignment="Stretch" />

                    <Border Grid.Row="3" Classes="expenses-card">
                            <Grid RowDefinitions="Auto, Auto, *">
                                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Texts.TransactionsSectionTitle}"
                                               Classes="card-title" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Texts.AllTransactionsLink}"
                                            Classes="link-button"
                                            Command="{Binding OpenAllTransactionsCommand}" />
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding Texts.NoTransactionsText}"
                                           IsVisible="{Binding HasNoTransactions}"
                                           Margin="0,0,0,8" />

                                <ItemsControl Grid.Row="2" ItemsSource="{Binding VisibleTransactions}" Background="{DynamicResource Color.AquaPanel}">
                                    <ItemsControl.Styles>
                                        <Style Selector="Button.transaction-row-button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                        </Style>
                                        <Style Selector="Button.transaction-row-button:pointerover">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                        </Style>
                                        <Style Selector="Button.transaction-row-button:pressed">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                        </Style>
                                        <Style Selector="Button.transaction-row-button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                        </Style>
                                        <Style Selector="Button.transaction-row-button:pressed /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                        </Style>
                                    </ItemsControl.Styles>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TransactionItemViewModel">
                                            <Button Background="Transparent"
                                                    Classes="transaction-row-button"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.EditTransactionCommand}"
                                                    CommandParameter="{Binding .}">
                                                <Border Classes="list-item-card">
                                                    <Grid ColumnSpacing="12"
                                                          VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="52" />
                                                            <ColumnDefinition Width="5*" MinWidth="100" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="80" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="40"
                                                                Height="40"
                                                                CornerRadius="8"
                                                                Background="{Binding CategoryAnchorBrush}">
                                                            <Grid>
                                                                <TextBlock Text="{Binding CategoryIcon}"
                                                                           FontFamily="{StaticResource EmojiFontFamily}"
                                                                           FontSize="18"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <Grid Grid.Column="1" ColumnDefinitions="220, Auto, *" ColumnSpacing="8" ClipToBounds="True">
                                                            <StackPanel Spacing="2" ClipToBounds="True">
                                                                <TextBlock Text="{Binding DescriptionDisplay}"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="14"
                                                                           FontWeight="Medium"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding TransactionDateDisplay}"
                                                                           Classes="muted"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Border Grid.Column="1"
                                                                    Background="{Binding GroupBrush}"
                                                                    CornerRadius="20"
                                                                    Padding="12,6"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Left"
                                                                    MinWidth="{ReflectionBinding $parent[UserControl].DataContext.TransactionGroupPillWidth}"
                                                                    IsVisible="{Binding IsShared}">
                                                                    <TextBlock Text="{Binding GroupDisplay}"
                                                                               HorizontalAlignment="Center"
                                                                               TextAlignment="Center"
                                                                               TextWrapping="Wrap"
                                                                               VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                        <Border Grid.Column="2"
                                                                Background="{Binding CategoryAnchorBrush}"
                                                                CornerRadius="20"
                                                                Padding="12,6"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Left"
                                                                MinWidth="{ReflectionBinding $parent[UserControl].DataContext.TransactionCategoryPillWidth}">
                                                            <TextBlock Text="{Binding CategoryDisplay}"
                                                                       HorizontalAlignment="Center"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left" ClipToBounds="True">
                                                            <TextBlock Text="{Binding AmountDisplay}"
                                                                       Foreground="{DynamicResource Color.Success}"
                                                                       FontWeight="Bold"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       IsVisible="{Binding IsIncome}" />
                                                            <TextBlock Text="{Binding AmountDisplay}"
                                                                       Foreground="{DynamicResource Color.Danger}"
                                                                       FontWeight="Bold"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       IsVisible="{Binding !IsIncome}" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>
</UserControl>
