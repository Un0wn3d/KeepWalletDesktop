<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="KeepWalletDesktop.Views.HomeView"
             x:DataType="vm:MainViewModel">
        <Border Grid.Column="1" Margin="16" IsVisible="{Binding IsHomePage}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="Auto, 260, Auto" RowSpacing="16" MaxWidth="1280">
                    <Border Grid.Row="0">
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="16">
                            <Border Grid.Column="0" Classes="metric-card total">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource Color.AccentSoft}">
                                        <TextBlock Text="Σ" Foreground="{DynamicResource Color.Accent}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Foreground="{DynamicResource Color.TextMuted}" Text="{Binding Texts.Total}" FontSize="12" />
                                        <TextBlock Foreground="{DynamicResource Color.Text1}"
                                               Text="{Binding Money}"
                                               Classes="amount-text"
                                               FontSize="36"
                                               FontWeight="Bold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Classes="metric-card income">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource Color.SuccessPanel}">
                                        <TextBlock Text="↑" Foreground="{DynamicResource Color.Success}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Foreground="{DynamicResource Color.TextMuted}" Text="{Binding Texts.Income}" FontSize="12" />
                                        <TextBlock Foreground="{DynamicResource Color.Text1}"
                                               Text="{Binding Income}"
                                               Classes="amount-text"
                                               FontSize="36"
                                               FontWeight="Bold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Classes="metric-card expense">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource Color.DangerPanel}">
                                        <TextBlock Text="↓" Foreground="{DynamicResource Color.Danger}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Foreground="{DynamicResource Color.TextMuted}" Text="{Binding Texts.Expenses}" FontSize="12" />
                                        <TextBlock Foreground="{DynamicResource Color.Text1}"
                                               Text="{Binding Expense}"
                                               Classes="amount-text"
                                               FontSize="36"
                                               FontWeight="Bold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1">
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                            <Button Grid.Column="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    MinHeight="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Command="{Binding OpenCategoryDetailsCommand}">
                                <Border Classes="panel-card alt"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <Grid RowDefinitions="Auto, *" RowSpacing="12">
                                        <TextBlock Foreground="{DynamicResource Color.Text1}"
                                                   Text="{Binding Texts.TransactionBreakdownTitle}"
                                                   Classes="section-title" />
                                        <Grid Grid.Row="1" ColumnDefinitions="*, 220" ColumnSpacing="10">
                                            <lvc:PieChart Grid.Column="0"
                                                          Background="{DynamicResource Color.Surface}"
                                                          LegendPosition="Hidden"
                                                          Series="{Binding Series}" />
                                            <ItemsControl Grid.Column="1"
                                                          ItemsSource="{Binding ExpenseCategoryLegend}"
                                                          IsVisible="{Binding HasExpenseTransactions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CategoryLegendItemViewModel">
                                                        <Grid ColumnDefinitions="14, *, Auto"
                                                              ColumnSpacing="8"
                                                              Margin="0,4">
                                                            <Border Width="10"
                                                                    Height="10"
                                                                    CornerRadius="5"
                                                                    Background="{Binding ColorBrush}"
                                                                    VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Name}"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding AmountDisplay}"
                                                                       Classes="muted"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Texts.ChartNoDataText}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding HasNoExpenseTransactions}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Button>
                            <Border Grid.Column="1" Classes="panel-card alt">
                                <Grid RowDefinitions="Auto, *" RowSpacing="12">
                                    <TextBlock Foreground="{DynamicResource Color.Text1}"
                                               Text="{Binding TransactionTimelineTitle}"
                                               Classes="section-title" />
                                    <Grid Grid.Row="1">
                                        <lvc:CartesianChart Background="Transparent"
                                                            Series="{Binding Chart}"
                                                            XAxes="{Binding TransactionTimelineXAxes}"
                                                            YAxes="{Binding TransactionTimelineYAxes}"
                                                            ZoomMode="X" />
                                        <TextBlock Text="{Binding Texts.ChartNoDataText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding HasNoTransactions}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Classes="expenses-card">
                            <Grid RowDefinitions="Auto, Auto, Auto, *">
                                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Texts.TransactionsSectionTitle}"
                                               Classes="card-title" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Texts.AllTransactionsLink}"
                                            Classes="link-button"
                                            Command="{Binding OpenAllTransactionsCommand}" />
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding Texts.NoTransactionsText}"
                                           IsVisible="{Binding HasNoTransactions}"
                                           Margin="0,0,0,8" />

                                <Grid Grid.Row="2"
                                      ColumnDefinitions="*, 180, Auto"
                                      ColumnSpacing="12"
                                      Margin="0,0,0,8"
                                      IsVisible="{Binding HasTransactions}">
                                    <TextBlock Text="{Binding Texts.TransactionDescriptionLabel}"
                                               Classes="muted"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Texts.TransactionCategoryLabel}"
                                               Classes="muted"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Texts.TransactionAmountLabel}"
                                               Classes="muted"
                                               FontWeight="SemiBold" />
                                </Grid>

                                <ItemsControl Grid.Row="3" ItemsSource="{Binding VisibleTransactions}" Background="Transparent">
                                    <ItemsControl.Styles>
                                        <Style Selector="Button.transaction-row-button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                        </Style>
                                        <Style Selector="Button.transaction-row-button:pointerover">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                        </Style>
                                        <Style Selector="Button.transaction-row-button:pressed">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                        </Style>
                                        <Style Selector="Button.transaction-row-button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                        </Style>
                                        <Style Selector="Button.transaction-row-button:pressed /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                        </Style>
                                    </ItemsControl.Styles>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TransactionItemViewModel">
                                            <Button Background="Transparent"
                                                    Classes="transaction-row-button"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.EditTransactionCommand}"
                                                    CommandParameter="{Binding .}">
                                                <Border Classes="list-item-card">
                                                    <Grid ColumnDefinitions="Auto, *, 180, Auto"
                                                          ColumnSpacing="12"
                                                          VerticalAlignment="Center">
                                                        <Border Width="40"
                                                                Height="40"
                                                                CornerRadius="8"
                                                                Background="{Binding CategoryAnchorBrush}">
                                                            <TextBlock Text="{Binding CategoryIcon}"
                                                                       Foreground="{DynamicResource Color.Text1}"
                                                                       FontSize="18"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Text="{Binding DescriptionDisplay}"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="14"
                                                                       FontWeight="Medium"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding TransactionDateDisplay}"
                                                                       Classes="muted" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2"
                                                                Background="{DynamicResource Color.SurfaceAlt}"
                                                                CornerRadius="16"
                                                                Padding="12,6"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CategoryDisplay}"
                                                                       TextWrapping="Wrap"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding AmountDisplay}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right"
                                                                   Classes="amount-text" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>
</UserControl>
