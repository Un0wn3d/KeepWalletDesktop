<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"             x:Class="KeepWalletDesktop.Views.Controls.TransactionDialogView"
             x:DataType="vm:MainViewModel">
        <UserControl.Styles>
            <Style Selector="Button.transaction-type-button">
                <Setter Property="Background" Value="{DynamicResource Color.InputSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Color.InputBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="MinWidth" Value="160" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style Selector="Button.transaction-type-button /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Color.InputSurface}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Color.Text1}" />
            </Style>
            <Style Selector="Button.transaction-type-button.selected">
                <Setter Property="Background" Value="{DynamicResource Color.InputSurface}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style Selector="Button.transaction-type-button.selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Color.InputSurface}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style Selector="Button.transaction-type-button:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Color.InputSurfaceHover}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderBrush" Value="{DynamicResource Color.Accent}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style Selector="Button.transaction-type-button:pressed /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Color.InputSurface}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style Selector="Button.transaction-type-button.expense.selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Color.InputSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Color.Danger}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Color.Danger}" />
            </Style>
            <Style Selector="Button.transaction-type-button.expense.selected:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Color.InputSurfaceHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Color.Danger}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Color.Danger}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style Selector="Button.transaction-type-button.income.selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Color.InputSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Color.Success}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Color.Success}" />
            </Style>
            <Style Selector="Button.transaction-type-button.income.selected:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Color.InputSurfaceHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Color.Success}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Color.Success}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style Selector="TextBox.auth-input, ComboBox, CalendarDatePicker.transaction-picker, TimePicker.transaction-picker">
                <Setter Property="Background" Value="{DynamicResource Color.InputSurface}" />
                <Setter Property="Foreground" Value="{DynamicResource Color.Text1}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Color.InputBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style Selector="CalendarDatePicker.transaction-picker /template/ Button#PART_Button">
                <Setter Property="Background" Value="{DynamicResource Color.InputSurface}" />
                <Setter Property="Foreground" Value="{DynamicResource Color.Text1}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Color.InputBorder}" />
            </Style>
            <Style Selector="TimePicker.transaction-picker /template/ TextBox">
                <Setter Property="Background" Value="{DynamicResource Color.InputSurface}" />
                <Setter Property="Foreground" Value="{DynamicResource Color.Text1}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Color.InputBorder}" />
            </Style>
            <Style Selector="TimePicker.transaction-picker /template/ Button">
                <Setter Property="Background" Value="{DynamicResource Color.InputSurface}" />
                <Setter Property="Foreground" Value="{DynamicResource Color.Text1}" />
            </Style>
            <Style Selector="CheckBox /template/ Border#NormalRectangle">
                <Setter Property="Background" Value="{DynamicResource Color.InputSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Color.InputBorder}" />
            </Style>
            <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
                <Setter Property="Background" Value="{DynamicResource Color.Accent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Color.Accent}" />
            </Style>
        </UserControl.Styles>
        <Border Grid.ColumnSpan="2"
                IsVisible="{Binding IsTransactionDialogOpen}"
                Background="{DynamicResource Color.Overlay}"
                PointerPressed="DialogOverlay_OnPointerPressed">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="480">
                <Border Classes="dialog-card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding TransactionDialogTitle}"
                                   HorizontalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="Bold" />

                        <TextBlock Text="{Binding Texts.BankAccountLabel}" Classes="form-label" />
                        <ComboBox ItemsSource="{Binding BankAccounts}"
                                  SelectedItem="{Binding SelectedBankAccount}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:BankAccountItemViewModel">
                                    <Grid ColumnDefinitions="*, Auto"
                                          ColumnSpacing="12"
                                          HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding BalanceDisplay}"
                                                   Classes="muted"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid ColumnDefinitions="3*, *" ColumnSpacing="10">
                            <StackPanel>
                                <TextBlock Text="{Binding Texts.TransactionDescriptionLabel}" Classes="form-label" />
                                <TextBox Text="{Binding TransactionDescriptionInput}"
                                         Watermark="{Binding Texts.TransactionDescriptionHint}"
                                         Classes="auth-input" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Texts.TransactionAmountLabel}" Classes="form-label" />
                                <TextBox Text="{Binding TransactionAmountInput}"
                                         Watermark="{Binding Texts.TransactionAmountHint}"
                                         Classes="auth-input" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Texts.TransactionTypeLabel}" Classes="form-label" />
                        <Border Background="{DynamicResource Color.Surface}"
                                CornerRadius="8"
                                Padding="4">
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="4">
                            <Button Content="{Binding Texts.TransactionExpenseType}"
                                    Classes="transaction-type-button expense"
                                    Classes.selected="{Binding IsExpenseTransactionTypeSelected}"
                                    Command="{Binding SelectTransactionTypeCommand}"
                                    CommandParameter="expense" />
                            <Button Grid.Column="1"
                                    Content="{Binding Texts.TransactionIncomeType}"
                                    Classes="transaction-type-button income"
                                    Classes.selected="{Binding IsIncomeTransactionTypeSelected}"
                                    Command="{Binding SelectTransactionTypeCommand}"
                                    CommandParameter="income" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding Texts.TransactionCategoryLabel}" Classes="form-label" />
                        <ComboBox ItemsSource="{Binding TransactionCategoryOptions}"
                                  SelectedItem="{Binding SelectedTransactionCategory}"
                                  SelectionChanged="TransactionCategoryComboBox_OnSelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <CheckBox Content="{Binding Texts.TransactionShareLabel}"
                                  IsChecked="{Binding IsTransactionSharedInput}"
                                  IsEnabled="{Binding CanEditTransactionShareGroups}" />
                        <ScrollViewer MaxHeight="110"
                                      IsVisible="{Binding IsTransactionSharedInput}"
                                      IsEnabled="{Binding CanEditTransactionShareGroups}">
                            <ItemsControl ItemsSource="{Binding TransactionShareGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GroupSelectionItemViewModel">
                                        <CheckBox Content="{Binding Name}"
                                                  Margin="0,0,14,8"
                                                  IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Grid.Resources>
                                <x:Double x:Key="TimePickerThemeMinWidth">0</x:Double>
                                <x:Double x:Key="TimePickerThemeMaxWidth">1000</x:Double>
                            </Grid.Resources>
                            
                            <StackPanel>
                                <TextBlock Text="{Binding Texts.TransactionDateLabel}" Classes="form-label" />
                                <CalendarDatePicker SelectedDate="{Binding TransactionDate, Mode=TwoWay}"
                                                HorizontalAlignment="Left"
                                                Width="210"
                                                CornerRadius="8"
                                                Classes="transaction-picker" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Texts.TransactionTimeLabel}" Classes="form-label" />
                                <TimePicker ClockIdentifier="24HourClock"
                                             SelectedTime="{Binding TransactionSelectedTime, Mode=TwoWay}"
                                             MinuteIncrement="1"
                                             Width="210"
                                             HorizontalAlignment="Left"
                                             Classes="transaction-picker" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="6"
                                    IsVisible="{Binding IsPlannedTransactionMode}">
                            <TextBlock Text="{Binding Texts.ScheduledPaymentRepeatLabel}" Classes="form-label" />
                            <ComboBox ItemsSource="{Binding ScheduledRepeatOptions}"
                                      SelectedItem="{Binding SelectedScheduledRepeatOption}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8"
                                  IsVisible="{Binding IsCustomScheduledRepeat}">
                                <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                                    <TextBox Text="{Binding ScheduledCustomPrimaryValueInput}"
                                             Classes="auth-input" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding ScheduledCustomRepeatUnitOptions}"
                                              SelectedItem="{Binding SelectedScheduledCustomPrimaryUnit}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Grid Grid.Column="1"
                                      ColumnDefinitions="110,*"
                                      ColumnSpacing="8"
                                      IsVisible="{Binding HasScheduledCustomSecondaryUnit}">
                                    <TextBox Text="{Binding ScheduledCustomSecondaryValueInput}"
                                             Classes="auth-input" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding ScheduledCustomSecondaryUnitOptions}"
                                              SelectedItem="{Binding SelectedScheduledCustomSecondaryUnit}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Grid Grid.Row="1"
                                      ColumnDefinitions="110,*"
                                      ColumnSpacing="8"
                                      IsVisible="{Binding HasScheduledCustomTertiaryUnit}">
                                    <TextBox Text="{Binding ScheduledCustomTertiaryValueInput}"
                                             Classes="auth-input" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding ScheduledCustomTertiaryUnitOptions}"
                                              SelectedItem="{Binding SelectedScheduledCustomTertiaryUnit}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Grid Grid.Row="1"
                                      Grid.Column="1"
                                      ColumnDefinitions="110,*"
                                      ColumnSpacing="8"
                                      IsVisible="{Binding HasScheduledCustomQuaternaryUnit}">
                                    <TextBox Text="{Binding ScheduledCustomQuaternaryValueInput}"
                                             Classes="auth-input" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding ScheduledCustomQuaternaryUnitOptions}"
                                              SelectedItem="{Binding SelectedScheduledCustomQuaternaryUnit}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="{Binding TransactionFormStatusMessage}"
                                   Foreground="{DynamicResource Color.Danger}"
                                   TextWrapping="Wrap" />

                        <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto" ColumnSpacing="8" Margin="0,8,0,0">
                            <Button Content="{Binding Texts.DeleteTransactionButton}"
                                    Classes="danger-button"
                                    Command="{Binding DeleteTransactionDialogCommand}" />
                            <Button Grid.Column="2"
                                    Width="44"
                                    Height="44"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Classes="primary-button"
                                    IsVisible="{Binding CanConfirmScheduledPaymentFromDialog}"
                                    Command="{Binding ConfirmScheduledPaymentFromDialogCommand}">
                                <Viewbox Width="18" Height="18">
                                    <TextBlock Text="&#xE34C;"
                                               FontFamily="{DynamicResource Phosphor-Fill}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Viewbox>
                            </Button>
                            <Button Grid.Column="3"
                                    Content="{Binding Texts.CancelButton}"
                                    Classes="secondary-button"
                                    Command="{Binding CloseTransactionDialogCommand}" />
                            <Button Grid.Column="4"
                                    Content="{Binding SaveTransactionButtonText}"
                                    Classes="primary-button"
                                    Command="{Binding SaveTransactionCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
</UserControl>
