<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="KeepWalletDesktop.Views.Controls.SavingsDialogOverlay"
             x:DataType="vm:MainViewModel">
    <Border IsVisible="{Binding IsSavingsDialogOpen}"
            Background="{DynamicResource Color.Overlay}"
            PointerPressed="SavingsDialogOverlay_OnPointerPressed">
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="460">
            <Border Classes="dialog-card">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Texts.CreateSavingsButton}"
                               HorizontalAlignment="Center"
                               FontSize="24"
                               FontWeight="Bold" />

                    <TextBlock Text="{Binding Texts.SavingNameLabel}" Classes="form-label" />
                    <TextBox Text="{Binding SavingsDialogNameInput}" />

                    <Grid ColumnDefinitions="Auto, *, 140" ColumnSpacing="8">
                        <TextBlock Text="{Binding Texts.GoalAmountLabel}" Classes="form-label" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Watermark="{Binding Texts.GoalAmountHint}"
                                 Text="{Binding SavingsDialogTargetAmountInput}" />
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding OnboardingCurrencyOptions}"
                                  SelectedItem="{Binding SavingsDialogCurrency}" />
                    </Grid>

                    <TextBlock Text="Target date" Classes="form-label" />
                    <TextBox Watermark="{Binding Texts.SavingsDeadlineHint}"
                             Text="{Binding SavingsDialogDeadlineInput}" />

                    <TextBlock Text="Icon and color" Classes="form-label" />
                    <Button Width="52"
                            Height="52"
                            CornerRadius="26"
                            Background="{Binding SavingsDialogColor}"
                            HorizontalAlignment="Left"
                            Click="SavingsDialogIconButton_OnClick">
                        <TextBlock Text="{Binding SavingsDialogIconGlyph}"
                                   FontFamily="{StaticResource EmojiFontFamily}"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>

                    <TextBlock Text="{Binding SavingsStatusMessage}"
                               Classes="message-text"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Content="{Binding Texts.SaveServerSettingsButton}"
                                Classes="primary-button"
                                Command="{Binding SaveNewSavingsCommand}" />
                        <Button Content="{Binding Texts.CancelButton}"
                                Classes="secondary-button"
                                Command="{Binding CloseSavingsDialogCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
