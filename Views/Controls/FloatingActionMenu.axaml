<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="200"
             x:DataType="vm:MainViewModel"
             x:Class="KeepWalletDesktop.Views.Controls.FloatingActionMenu">

    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Spacing="10">
            <Border x:Name="ActionList"
                    IsVisible="False"
                    Classes="fab-menu">
                <StackPanel Spacing="8">
                    <Button Content="{Binding Texts.CreateTransactionButton}"
                            Click="CreateTransaction_Click" />
                    <Button Content="{Binding Texts.CreatePiggyBankButton}"
                            Click="CreatePiggyBank_Click" />
                </StackPanel>
            </Border>

            <Button Classes="fab-button"
                    Content="+"
                    Click="ToggleFab_Click" />
        </StackPanel>
    </Grid>
</UserControl>
