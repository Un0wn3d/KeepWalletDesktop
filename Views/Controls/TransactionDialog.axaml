<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"             x:Class="KeepWalletDesktop.Views.Controls.TransactionDialog"
             x:DataType="vm:MainViewModel">
        <UserControl.Styles>
            <Style Selector="ToggleButton.transaction-type-button">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{DynamicResource Color.BorderSoft}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="MinWidth" Value="160" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style Selector="ToggleButton.transaction-type-button /template/ ContentPresenter">
                <Setter Property="Background" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Color.Text1}" />
            </Style>
            <Style Selector="ToggleButton.transaction-type-button:checked">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style Selector="ToggleButton.transaction-type-button:checked /template/ ContentPresenter">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style Selector="ToggleButton.transaction-type-button:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderBrush" Value="Black" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style Selector="ToggleButton.transaction-type-button:pressed /template/ ContentPresenter">
                <Setter Property="Background" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style Selector="ToggleButton.transaction-type-button.expense:checked /template/ ContentPresenter">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{DynamicResource Color.Danger}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Color.Danger}" />
            </Style>
            <Style Selector="ToggleButton.transaction-type-button.expense:checked:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{DynamicResource Color.Danger}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Color.Danger}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style Selector="ToggleButton.transaction-type-button.income:checked /template/ ContentPresenter">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{DynamicResource Color.Success}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Color.Success}" />
            </Style>
            <Style Selector="ToggleButton.transaction-type-button.income:checked:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{DynamicResource Color.Success}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Color.Success}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </UserControl.Styles>
        <Border Grid.ColumnSpan="2"
                IsVisible="{Binding IsTransactionDialogOpen}"
                Background="{DynamicResource Color.Overlay}">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="480">
                <Border Classes="dialog-card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding TransactionDialogTitle}"
                                   HorizontalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="Bold" />

                        <TextBlock Text="{Binding Texts.TransactionDescriptionLabel}" Classes="form-label" />
                        <TextBox Text="{Binding TransactionDescriptionInput}"
                                 Watermark="{Binding Texts.TransactionDescriptionHint}"
                                 Classes="auth-input" />

                        <TextBlock Text="{Binding Texts.TransactionAmountLabel}" Classes="form-label" />
                        <TextBox Text="{Binding TransactionAmountInput}"
                                 Watermark="{Binding Texts.TransactionAmountHint}"
                                 Classes="auth-input" />

                        <TextBlock Text="{Binding Texts.TransactionTypeLabel}" Classes="form-label" />
                        <Border Background="{DynamicResource Color.Surface}"
                                CornerRadius="8"
                                Padding="4">
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="4">
                            <ToggleButton Content="{Binding Texts.TransactionExpenseType}"
                                          Classes="transaction-type-button expense"
                                          IsChecked="{Binding IsExpenseTransactionTypeSelected, Mode=OneWay}"
                                          Command="{Binding SelectTransactionTypeCommand}"
                                          CommandParameter="expense" />
                            <ToggleButton Grid.Column="1"
                                          Content="{Binding Texts.TransactionIncomeType}"
                                          Classes="transaction-type-button income"
                                          IsChecked="{Binding IsIncomeTransactionTypeSelected, Mode=OneWay}"
                                          Command="{Binding SelectTransactionTypeCommand}"
                                          CommandParameter="income" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding Texts.TransactionCategoryLabel}" Classes="form-label" />
                        <ComboBox ItemsSource="{Binding TransactionCategoryOptions}"
                                  SelectedItem="{Binding SelectedTransactionCategory}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <CheckBox Content="{Binding Texts.TransactionShareLabel}"
                                  IsChecked="{Binding IsTransactionSharedInput}" />
                        <ComboBox ItemsSource="{Binding Groups}"
                                  SelectedItem="{Binding SelectedTransactionShareGroup}"
                                  IsVisible="{Binding IsTransactionSharedInput}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GroupItemViewModel">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Grid.Resources>
                                <x:Double x:Key="TimePickerThemeMinWidth">0</x:Double>
                                <x:Double x:Key="TimePickerThemeMaxWidth">1000</x:Double>
                            </Grid.Resources>
                            
                            <StackPanel>
                                <TextBlock Text="{Binding Texts.TransactionDateLabel}" Classes="form-label" />
                                <CalendarDatePicker SelectedDate="{Binding TransactionDate, Mode=TwoWay}"
                                                HorizontalAlignment="Left"
                                                Width="210"
                                                CornerRadius="8"
                                                Classes="transaction-picker" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Texts.TransactionTimeLabel}" Classes="form-label" />
                                <TimePicker ClockIdentifier="24HourClock"
                                             SelectedTime="{Binding TransactionSelectedTime, Mode=TwoWay}"
                                             MinuteIncrement="1"
                                             Width="210"
                                             HorizontalAlignment="Left"
                                             Classes="transaction-picker" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="6"
                                    IsVisible="{Binding IsPlannedTransactionMode}">
                            <TextBlock Text="{Binding Texts.ScheduledPaymentRepeatLabel}" Classes="form-label" />
                            <ComboBox ItemsSource="{Binding ScheduledRepeatOptions}"
                                      SelectedItem="{Binding SelectedScheduledRepeatOption}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Watermark="{Binding Texts.ScheduledPaymentCustomRepeatHint}"
                                     Text="{Binding ScheduledPaymentCustomRepeatInput}"
                                     IsVisible="{Binding IsCustomScheduledRepeat}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8" Margin="0,8,0,0">
                            <Button Content="{Binding Texts.DeleteTransactionButton}"
                                    Classes="danger-button"
                                    Command="{Binding DeleteTransactionCommand}" />
                            <Button Grid.Column="2"
                                    Content="{Binding Texts.CancelButton}"
                                    Classes="secondary-button"
                                    Command="{Binding CloseTransactionDialogCommand}" />
                            <Button Grid.Column="3"
                                    Content="{Binding SaveTransactionButtonText}"
                                    Classes="primary-button"
                                    Command="{Binding SaveTransactionCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
</UserControl>
