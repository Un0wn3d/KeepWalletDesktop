<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"             x:Class="KeepWalletDesktop.Views.Controls.BankAccountDialog"
             x:DataType="vm:MainViewModel">
        <Border Grid.ColumnSpan="2"
                IsVisible="{Binding IsBankAccountDialogOpen}"
                Background="{DynamicResource Color.Overlay}">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="420">
                <Border Classes="dialog-card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding BankAccountDialogTitle}"
                                   HorizontalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="Bold" />

                        <TextBlock Text="{Binding Texts.OnboardingAccountNameLabel}" Classes="form-label" />
                        <TextBox Text="{Binding BankAccountNameInput}" />

                        <TextBlock Text="{Binding Texts.TransactionCurrencyLabel}" Classes="form-label" />
                        <TextBox Text="{Binding BankAccountCurrencyInput}" />

                        <TextBlock Text="{Binding Texts.TransactionAmountLabel}" Classes="form-label" />
                        <TextBox Text="{Binding BankAccountBalanceInput}" />

                        <CheckBox Content="{Binding Texts.BankAccountDefaultLabel}"
                                  IsChecked="{Binding IsBankAccountDefaultInput}" />

                        <CheckBox Content="Поділитися акаунтом"
                                  IsChecked="{Binding IsBankAccountSharedInput}" />
                        <ComboBox ItemsSource="{Binding Groups}"
                                  SelectedItem="{Binding SelectedBankAccountShareGroup}"
                                  IsVisible="{Binding IsBankAccountSharedInput}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GroupItemViewModel">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{Binding BankAccountStatusMessage}"
                                   Classes="message-text" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button Content="{Binding Texts.DeleteTransactionButton}"
                                    Classes="secondary-button"
                                    IsVisible="{Binding IsEditingBankAccount}"
                                    Command="{Binding DeleteBankAccountCommand}" />
                            <Button Content="{Binding SaveBankAccountButtonText}"
                                    Classes="primary-button"
                                    Command="{Binding SaveBankAccountCommand}" />
                            <Button Content="{Binding Texts.CancelButton}"
                                    Classes="secondary-button"
                                    Command="{Binding CloseBankAccountDialogCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
</UserControl>
