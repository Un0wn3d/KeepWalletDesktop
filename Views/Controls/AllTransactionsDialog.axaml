<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"             x:Class="KeepWalletDesktop.Views.Controls.AllTransactionsDialog"
             x:DataType="vm:MainViewModel">
        <Border Grid.ColumnSpan="2"
                IsVisible="{Binding IsAllTransactionsDialogOpen}"
                Background="{DynamicResource Color.Overlay}">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="760"
                  MaxHeight="640">
                <Border Classes="dialog-card">
                    <Grid RowDefinitions="Auto, Auto, Auto, *" RowSpacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="{Binding Texts.AllTransactionsLink}"
                                       FontSize="24"
                                       FontWeight="Bold" />
                            <Button Grid.Column="1"
                                    Content="{Binding Texts.CancelButton}"
                                    Classes="secondary-button"
                                    Command="{Binding CloseAllTransactionsCommand}" />
                        </Grid>

                        <Grid Grid.Row="2"
                              ColumnDefinitions="2*, Auto, 2*"
                              ColumnSpacing="10">
                            <TextBox Text="{Binding TransactionSearchText}"
                                     Watermark="{Binding Texts.TransactionDescriptionHint}" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding TransactionTypeFilterOptions}"
                                      SelectedItem="{Binding SelectedTransactionTypeFilter}"
                                      MinWidth="120" />
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding TransactionCategoryFilterOptions}"
                                      SelectedItem="{Binding SelectedTransactionCategoryFilter}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="52, 5*, 2*, 2*"
                              ColumnSpacing="12"
                              Margin="8,0,8,0"
                              IsVisible="{Binding HasAllTransactions}">
                            <TextBlock />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Texts.TransactionDescriptionLabel}"
                                       Classes="muted"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Texts.TransactionCategoryLabel}"
                                       HorizontalAlignment="Center"
                                       Classes="muted"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Texts.TransactionAmountLabel}"
                                       Classes="muted"
                                       FontWeight="SemiBold" />
                        </Grid>

                        <ScrollViewer Grid.Row="3"
                                      x:Name="TransactionsScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="TransactionsScrollViewer_OnScrollChanged">
                            <ItemsControl ItemsSource="{Binding FilteredTransactions}" Background="Transparent">
                                <ItemsControl.Styles>
                                    <Style Selector="Button.transaction-row-button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                    </Style>
                                    <Style Selector="Button.transaction-row-button:pointerover">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                    </Style>
                                    <Style Selector="Button.transaction-row-button:pressed">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                    </Style>
                                    <Style Selector="Button.transaction-row-button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                    </Style>
                                    <Style Selector="Button.transaction-row-button:pressed /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                    </Style>
                                </ItemsControl.Styles>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TransactionItemViewModel">
                                        <Button Background="Transparent"
                                                Classes="transaction-row-button"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{ReflectionBinding $parent[UserControl].DataContext.EditTransactionCommand}"
                                                CommandParameter="{Binding .}">
                                            <Border Classes="list-item-card">
                                                <Grid ColumnDefinitions="52, 5*, 2*, 2*"
                                                      ColumnSpacing="12"
                                                      VerticalAlignment="Center">
                                                    <Border Width="40"
                                                            Height="40"
                                                            CornerRadius="8"
                                                            Background="{Binding CategoryAnchorBrush}">
                                                        <Grid>
                                                            <TextBlock Text="{Binding CategoryIcon}"
                                                                       FontFamily="Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji, sans-serif"
                                                                       Foreground="{DynamicResource Color.Text1}"
                                                                       FontSize="18"
                                                                       FontWeight="SemiBold"
                                                                       IsVisible="{Binding !HasCategoryIconSampleImage}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <Image Source="{Binding CategoryIconSampleImage}"
                                                                   Width="26"
                                                                   Height="26"
                                                                   IsVisible="{Binding HasCategoryIconSampleImage}" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding DescriptionDisplay}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="14"
                                                                   FontWeight="Medium"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding TransactionDateDisplay}"
                                                                   Classes="muted" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2"
                                                            Background="{DynamicResource Color.SurfaceAlt}"
                                                            CornerRadius="20"
                                                            Padding="12,6"
                                                            HorizontalAlignment="Center"
                                                            MinWidth="{Binding $parent[UserControl].DataContext.TransactionCategoryPillWidth}">
                                                        <TextBlock Text="{Binding CategoryDisplay}"
                                                                   HorizontalAlignment="Center"
                                                                   TextAlignment="Center" />
                                                    </Border>
                                                    <Grid Grid.Column="3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AmountDisplay}"
                                                                   Foreground="{DynamicResource Color.Success}"
                                                                   FontWeight="Bold"
                                                                   IsVisible="{Binding IsIncome}" />
                                                        <TextBlock Text="{Binding AmountDisplay}"
                                                                   Foreground="{DynamicResource Color.Danger}"
                                                                   FontWeight="Bold"
                                                                   IsVisible="{Binding !IsIncome}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
</UserControl>
