<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="620"
             d:DesignHeight="120"
             x:Class="KeepWalletDesktop.Views.Modules.AddCategoryModuleView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="Button.category-icon-button">
            <Setter Property="Background" Value="{DynamicResource Color.InputSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Color.InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.category-type-button">
            <Setter Property="Background" Value="{DynamicResource Color.InputSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource Color.Text1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Color.InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.category-type-button.selected">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.category-type-button.expense.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource Color.Danger}" />
            <Setter Property="Foreground" Value="{DynamicResource Color.Danger}" />
        </Style>
        <Style Selector="Button.category-type-button.income.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource Color.Success}" />
            <Setter Property="Foreground" Value="{DynamicResource Color.Success}" />
        </Style>
        <Style Selector="TextBox.add-category-name-input">
            <Setter Property="Background" Value="{DynamicResource Color.InputSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource Color.Text1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Color.InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Styles>

    <Border Classes="panel-card alt">
        <StackPanel Spacing="12">
            <TextBlock Text="{Binding Texts.OnboardingAddCategoryTitle}"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto" ColumnSpacing="8">
                <Button Width="40"
                        Height="40"
                        Padding="0"
                        Classes="category-icon-button"
                        Background="{Binding CategoryNewColor}"
                        Click="NewCategoryIconButton_OnClick"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                    <TextBlock Text="{Binding CategoryNewIconGlyph}"
                               FontFamily="{StaticResource EmojiFontFamily}"
                               FontSize="18"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
                <TextBox Grid.Column="1"
                         Classes="add-category-name-input"
                         Text="{Binding CategoryNewName}"
                         Watermark="{Binding Texts.OnboardingCategoryNameHint}" />
                <Button Grid.Column="2"
                        Content="{Binding Texts.TransactionExpenseType}"
                        Classes="category-type-button expense"
                        Classes.selected="{Binding IsNewCategoryExpenseTypeSelected}"
                        Command="{Binding SelectCategoryTypeCommand}"
                        CommandParameter="expense" />
                <Button Grid.Column="3"
                        Content="{Binding Texts.TransactionIncomeType}"
                        Classes="category-type-button income"
                        Classes.selected="{Binding IsNewCategoryIncomeTypeSelected}"
                        Command="{Binding SelectCategoryTypeCommand}"
                        CommandParameter="income" />
                <Button Grid.Column="4"
                        Content="{Binding Texts.OnboardingAddCategoryButton}"
                        Classes="primary-button"
                        Command="{Binding AddCategoryCommand}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
