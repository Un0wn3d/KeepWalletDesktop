<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="520"
             d:DesignHeight="52"
             x:Class="KeepWalletDesktop.Views.Modules.DateSortModuleView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="FlyoutPresenter">
            <Setter Property="MinWidth" Value="560" />
            <Setter Property="MaxWidth" Value="660" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource Color.SurfaceAlt}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Styles>

    <Border Classes="panel-card alt"
            Padding="6"
            HorizontalAlignment="Stretch">
        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding !IsScheduledPaymentsPage}">
                <Button Content="&lt;&lt;"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Height="30"
                        MinWidth="48"
                        Background="{DynamicResource Color.InputSurface}"
                        Foreground="{DynamicResource Color.Text1}"
                        BorderBrush="{DynamicResource Color.InputBorder}"
                        Click="PreviousButton_Click" />

                <Button x:Name="PeriodButton"
                        MinWidth="180"
                        Height="30"
                        Background="{DynamicResource Color.InputSurface}"
                        Foreground="{DynamicResource Color.Text1}"
                        BorderBrush="{DynamicResource Color.InputBorder}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="{Binding Texts.DateRangeThisMonth}">
                    <Button.Flyout>
                        <Flyout Placement="Bottom"
                                VerticalOffset="13"
                                Opened="PeriodFlyout_Opened">
                                <Border Padding="10"
                                        CornerRadius="8"
                                        Margin="0"
                                        Background="{DynamicResource Color.SurfaceAlt}">
                                <Grid ColumnDefinitions="350, 200" ColumnSpacing="12">
                                    <StackPanel Spacing="10">
                                        <Calendar x:Name="RangeCalendar"
                                                  SelectionMode="SingleRange"
                                                  SelectedDatesChanged="RangeCalendar_SelectedDatesChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <Button Content="{Binding Texts.DateRangeLastHour}"
                                                HorizontalContentAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                                Background="{DynamicResource Color.InputSurface}"
                                                Foreground="{DynamicResource Color.Text1}"
                                                BorderBrush="{DynamicResource Color.InputBorder}"
                                                Click="LastHourButton_Click" />
                                        <Button Content="{Binding Texts.DateRangeLastTwoHours}"
                                                HorizontalContentAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                                Background="{DynamicResource Color.InputSurface}"
                                                Foreground="{DynamicResource Color.Text1}"
                                                BorderBrush="{DynamicResource Color.InputBorder}"
                                                Click="LastTwoHoursButton_Click" />
                                        <Button Content="{Binding Texts.DateRangeLastThreeHours}"
                                                HorizontalContentAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                                Background="{DynamicResource Color.InputSurface}"
                                                Foreground="{DynamicResource Color.Text1}"
                                                BorderBrush="{DynamicResource Color.InputBorder}"
                                                Click="LastThreeHoursButton_Click" />
                                        <Button Content="{Binding Texts.DateRangeLastSixHours}"
                                                HorizontalContentAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                                Background="{DynamicResource Color.InputSurface}"
                                                Foreground="{DynamicResource Color.Text1}"
                                                BorderBrush="{DynamicResource Color.InputBorder}"
                                                Click="LastSixHoursButton_Click" />
                                        <Button Content="{Binding Texts.DateRangeLastTwelveHours}"
                                                HorizontalContentAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                                Background="{DynamicResource Color.InputSurface}"
                                                Foreground="{DynamicResource Color.Text1}"
                                                BorderBrush="{DynamicResource Color.InputBorder}"
                                                Click="LastTwelveHoursButton_Click" />
                                        <Button Content="{Binding Texts.DateRangeLastDay}"
                                                HorizontalContentAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                                Background="{DynamicResource Color.InputSurface}"
                                                Foreground="{DynamicResource Color.Text1}"
                                                BorderBrush="{DynamicResource Color.InputBorder}"
                                                Click="LastDayButton_Click" />
                                        <Button Content="{Binding Texts.DateRangeLastWeek}"
                                                HorizontalContentAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                                Background="{DynamicResource Color.InputSurface}"
                                                Foreground="{DynamicResource Color.Text1}"
                                                BorderBrush="{DynamicResource Color.InputBorder}"
                                                Click="LastWeekButton_Click" />
                                        <Button Content="{Binding Texts.DateRangeThisMonth}"
                                                HorizontalContentAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                                Background="{DynamicResource Color.InputSurface}"
                                                Foreground="{DynamicResource Color.Text1}"
                                                BorderBrush="{DynamicResource Color.InputBorder}"
                                                Click="LastMonthButton_Click" />
                                        <Button Content="{Binding Texts.DateRangeLastHalfYear}"
                                                HorizontalContentAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                                Background="{DynamicResource Color.InputSurface}"
                                                Foreground="{DynamicResource Color.Text1}"
                                                BorderBrush="{DynamicResource Color.InputBorder}"
                                                Click="LastHalfYearButton_Click" />
                                        <Button Content="{Binding Texts.DateRangeLastYear}"
                                                HorizontalContentAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                                Background="{DynamicResource Color.InputSurface}"
                                                Foreground="{DynamicResource Color.Text1}"
                                                BorderBrush="{DynamicResource Color.InputBorder}"
                                                Click="LastYearButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Content="&gt;&gt;"
                        MinWidth="48"
                        Height="30"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource Color.InputSurface}"
                        Foreground="{DynamicResource Color.Text1}"
                        BorderBrush="{DynamicResource Color.InputBorder}"
                        Click="NextButton_Click" />
            </StackPanel>

            <Grid ColumnDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="8"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding IsScheduledPaymentsPage}">
                <Button Content="{Binding Texts.ScheduledPaymentsFilterAll}"
                        Classes="secondary-button"
                        Command="{Binding SetScheduledPaymentsFilterCommand}"
                        CommandParameter="all" />
                <Button Grid.Column="1"
                        Content="{Binding Texts.ScheduledPaymentsFilterFuture}"
                        Classes="secondary-button"
                        Command="{Binding SetScheduledPaymentsFilterCommand}"
                        CommandParameter="future" />
                <Button Grid.Column="2"
                        Content="{Binding Texts.ScheduledPaymentsFilterOverdue}"
                        Classes="secondary-button"
                        Command="{Binding SetScheduledPaymentsFilterCommand}"
                        CommandParameter="overdue" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
