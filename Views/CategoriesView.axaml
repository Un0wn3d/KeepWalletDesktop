<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeepWalletDesktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="650"
             x:Class="KeepWalletDesktop.Views.CategoriesView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="Button.category-icon-button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource Color.BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Styles>

    <Border Grid.Column="1" Margin="16" IsVisible="{Binding IsCategoriesPage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="1120">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                    <TextBlock Text="{Binding Texts.OnboardingCategoriesTitle}"
                               Classes="page-title" />
                    <Button Grid.Column="1"
                            Content="{Binding Texts.SaveServerSettingsButton}"
                            Classes="primary-button"
                            Command="{Binding SaveCategoriesCommand}" />
                </Grid>

                <Border Classes="panel-card alt">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Texts.OnboardingAddCategoryTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto" ColumnSpacing="8">
                            <Button Width="40"
                                    Height="40"
                                    Padding="0"
                                    Classes="category-icon-button"
                                    Click="NewCategoryIconButton_OnClick"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center">
                                <Grid>
                                    <TextBlock Text="{Binding CategoryNewIconGlyph}"
                                               FontFamily="{StaticResource EmojiFontFamily}"
                                               FontSize="18"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <TextBox Grid.Column="1"
                                     Text="{Binding CategoryNewName}"
                                     Watermark="{Binding Texts.OnboardingCategoryNameHint}" />
                            <Button Grid.Column="2"
                                    Content="{Binding Texts.TransactionExpenseType}"
                                    Classes="secondary-button"
                                    Command="{Binding SelectCategoryTypeCommand}"
                                    CommandParameter="expense" />
                            <Button Grid.Column="3"
                                    Content="{Binding Texts.TransactionIncomeType}"
                                    Classes="secondary-button"
                                    Command="{Binding SelectCategoryTypeCommand}"
                                    CommandParameter="income" />
                            <Button Grid.Column="4"
                                    Content="{Binding Texts.OnboardingAddCategoryButton}"
                                    Classes="primary-button"
                                    Command="{Binding AddCategoryCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                    <Border Classes="panel-card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding Texts.TransactionExpenseType}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding ExpenseCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CategoryManagementItemViewModel">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="12" Margin="0,4">
                                            <Button Width="40"
                                                    Height="40"
                                                    Padding="0"
                                                    Classes="category-icon-button"
                                                    Grid.Column="0"
                                                    Click="CategoryIconButton_OnClick"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center">
                                                <Grid>
                                                    <TextBlock Text="{Binding IconGlyph}"
                                                               FontFamily="{StaticResource EmojiFontFamily}"
                                                               FontSize="18"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="Medium"
                                                           DoubleTapped="CategoryName_OnDoubleTapped"
                                                           IsVisible="{Binding !IsEditingName}" />
                                                <TextBox Text="{Binding NameInput}"
                                                         Width="180"
                                                         HorizontalAlignment="Left"
                                                         LostFocus="CategoryNameTextBox_OnLostFocus"
                                                         KeyDown="CategoryNameTextBox_OnKeyDown"
                                                         IsVisible="{Binding IsEditingName}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2"
                                                          IsChecked="{Binding IsSelected}" />
                                            <Button Grid.Column="3"
                                                    Width="44"
                                                    Height="44"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Classes="danger-button"
                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.DeleteCategoryCommand}"
                                                    CommandParameter="{Binding .}">
                                                <Viewbox Width="18" Height="18">
                                                    <TextBlock Text="&#xE4A6;"
                                                               FontFamily="{DynamicResource Phosphor-Fill}"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="panel-card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding Texts.TransactionIncomeType}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding IncomeCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CategoryManagementItemViewModel">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="12" Margin="0,4">
                                            <Button Width="40"
                                                    Height="40"
                                                    Padding="0"
                                                    Classes="category-icon-button"
                                                    Grid.Column="0"
                                                    Click="CategoryIconButton_OnClick"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center">
                                                <Grid>
                                                    <TextBlock Text="{Binding IconGlyph}"
                                                               FontFamily="{StaticResource EmojiFontFamily}"
                                                               FontSize="18"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="Medium"
                                                           DoubleTapped="CategoryName_OnDoubleTapped"
                                                           IsVisible="{Binding !IsEditingName}" />
                                                <TextBox Text="{Binding NameInput}"
                                                         Width="180"
                                                         HorizontalAlignment="Left"
                                                         LostFocus="CategoryNameTextBox_OnLostFocus"
                                                         KeyDown="CategoryNameTextBox_OnKeyDown"
                                                         IsVisible="{Binding IsEditingName}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2"
                                                          IsChecked="{Binding IsSelected}" />
                                            <Button Grid.Column="3"
                                                    Width="44"
                                                    Height="44"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Classes="danger-button"
                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.DeleteCategoryCommand}"
                                                    CommandParameter="{Binding .}">
                                                <Viewbox Width="18" Height="18">
                                                    <TextBlock Text="&#xE4A6;"
                                                               FontFamily="{DynamicResource Phosphor-Fill}"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Classes="panel-card alt">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Texts.MergeCategoriesTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*, Auto, *, Auto" ColumnSpacing="8">
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedMergeSourceCategory}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CategoryManagementItemViewModel">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Border Grid.Column="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Padding="4,0">
                                <TextBlock Text="&#x2192;"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Border>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding MergeTargetCategories}"
                                      SelectedItem="{Binding SelectedMergeTargetCategory}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CategoryManagementItemViewModel">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="3"
                                    Content="{Binding Texts.MergeCategoriesButton}"
                                    Classes="primary-button"
                                    Command="{Binding MergeCategoriesCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding CategoryStatusMessage}"
                           Classes="muted"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
