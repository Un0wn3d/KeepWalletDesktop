<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Diplom.ViewModels"
        xmlns:Services="using:Diplom"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Diplom.Views.Controls"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:sys="clr-namespace:System;assembly=netstandard"
        xmlns:scg="clr-namespace:System.Collections.Generic;assembly=netstandard"
        xmlns:services="clr-namespace:Diplom.Services"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Diplom.Views.MainView"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Diplom"
        Background="{DynamicResource Color.Background}">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel/>
    </Design.DataContext>

    <!-- APP -->
        
    <Grid ColumnDefinitions="Auto, *" MinWidth="500">
        <!-- Left Panel -->
        <controls:LeftPanel Grid.Column="0"></controls:LeftPanel>
        
        
        <!-- Main -->
        <Border Grid.Column="1" Margin="10, 10, 10, 10">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
            
            <!-- Up Panel, money, analysis, all transactions -->
            <Grid RowDefinitions="Auto, 100, 300, Auto" RowSpacing="10">
                <!-- Up Panel -->
                <Border Grid.Row="0" BorderThickness="0">
                    <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Hello, Vadym" />
                    <Button Grid.Column="1" Name="Language">Lng</Button>
                    </Grid>
                </Border>
                
                <!-- Money -->
                <Border Grid.Row="1">
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                        <Border Grid.Column="0" Background="Blue" CornerRadius="15" Padding="10">
                            <TextBlock Foreground="{DynamicResource Color.Text2}" Text="Всього" />
                        </Border>
                        <Border Grid.Column="1" Background="Green" CornerRadius="15" Padding="10">
                            <TextBlock Foreground="{DynamicResource Color.Text2}" Text="Дохід" />
                        </Border>
                        <Border Grid.Column="2" Background="Red" CornerRadius="15" Padding="10">
                            <TextBlock Foreground="{DynamicResource Color.Text2}" Text="Витрати" />
                        </Border>
                    </Grid>
                </Border>
                
                <!-- analysis -->
                <Border Grid.Row="2">
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Border Grid.Column="0" Background="AliceBlue" CornerRadius="15" Padding="10">
                            <Grid RowDefinitions="Auto, *">
                                <TextBlock Foreground="{DynamicResource Color.Text1}" Text="Витрати за категоріями" />
                                
                                <lvc:PieChart Grid.Row="1" Background="AliceBlue"
                                    Series="{Binding Series}">
                                </lvc:PieChart>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="AliceBlue" CornerRadius="15" Padding="10">
                            <Grid RowDefinitions="Auto, *">
                                <TextBlock Foreground="{DynamicResource Color.Text1}" Text="Доходи та Витрати" />
                                <lvc:CartesianChart Grid.Row="1" SeriesSource="" Background="AliceBlue" Foreground="{DynamicResource Color.Text1}">
                                    <lvc:CartesianChart.SeriesTemplate>
                                        <DataTemplate>
                                            <lvc:XamlColumnSeries
                                                SeriesName="123"
                                                Values="2"
                                                Fill=""/>
                                        </DataTemplate>
                                    </lvc:CartesianChart.SeriesTemplate>
                                </lvc:CartesianChart>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                
                <!-- all transactions -->
                <Border Grid.Row="3" Background="Aquamarine" CornerRadius="15" Padding="10">
                    <Grid RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Text="Останні витрати"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>
                        
                        <ListBox Grid.Row="1" ItemsSource="{Binding LatestExpenses}" Background="Aquamarine">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,6" Padding="8" Background="#EEFFFFFF" CornerRadius="8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Type}" 
                                                       Foreground="Black" 
                                                       VerticalAlignment="Center"/>
                    
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Cost, StringFormat='{}{0:F2}'}" 
                                                       Foreground="Black" 
                                                       FontWeight="Bold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
    </ScrollViewer>
        </Border>
    </Grid>
    
    

</Window>
