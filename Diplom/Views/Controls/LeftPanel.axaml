<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Diplom.Views.Controls.LeftPanel">
    <!-- Left Panel -->
    <Border Background="{DynamicResource Color.LeftPanel}" 
            Width="77"
            HorizontalAlignment="Left"
            BorderThickness="0"
            Padding="15"
            CornerRadius="15"
            VerticalAlignment="Stretch"
            Margin="10">
            
        <Grid RowDefinitions="Auto, *, Auto"
              HorizontalAlignment="Center">
                
            <!-- Icon -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <Image Source="../../Assets/avalonia-logo.ico" />
            </StackPanel>
            
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="2" >
                <Button>
                    <StackPanel>
                        <Button FontFamily="{DynamicResource Phosphor-Fill}" 
                               Classes="icon" 
                               Content="&#xE2C2;" 
                               Foreground="Cyan"
                               FontSize="25"
                               Click="btn_Home">
                        </Button>
                        <!-- <Label Content="Home"></Label> -->
                    </StackPanel>
                </Button>
                <Button>
                    <Label FontFamily="{DynamicResource Phosphor-Fill}" Classes="icon" Content="&#xE1D2;"
                           Foreground="Cyan"
                           FontSize="25"></Label>
                </Button>
                <Button>
                    <Label FontFamily="{DynamicResource Phosphor-Fill}" Classes="icon" Content="&#xEA04;"
                           Foreground="Cyan"
                           FontSize="25"></Label>
                </Button>
                <Button>
                    <Label FontFamily="{DynamicResource Phosphor-Fill}" Classes="icon" Content="&#xE4AE;"
                           Foreground="Cyan"
                           FontSize="25"></Label>
                </Button>
                <Button>
                    <Label FontFamily="{DynamicResource Phosphor-Fill}" Classes="icon" Content="&#xE10A;"
                           Foreground="Cyan"
                           FontSize="25"></Label>
                </Button>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                <Button Focusable="False" Name="Settings">
                    <Label FontFamily="{DynamicResource Phosphor-Fill}" Classes="icon" Content="&#xE270;"
                               Foreground="Cyan"
                               FontSize="25"></Label>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
