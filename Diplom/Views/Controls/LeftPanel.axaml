<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Diplom.Views.Controls.LeftPanel">
    <!-- Left Panel -->
    <Border Background="{DynamicResource Color.LeftPanel}" 
            Width="77"
            HorizontalAlignment="Left"
            BorderThickness="0"
            Padding="15"
            CornerRadius="15"
            VerticalAlignment="Stretch"
            Margin="10">
            
        <Grid RowDefinitions="Auto, *, Auto"
              HorizontalAlignment="Center">
                
            <!-- Icon -->
            <StackPanel Grid.Row="0">
                <Image Source="../../Assets/avalonia-logo.ico" />
            </StackPanel>
            
            <StackPanel Grid.Row="1">
                <Button Background="Aqua">
                    <StackPanel>
                        <Label FontFamily="{DynamicResource Phosphor-Fill}" Classes="icon" Content="&#xE2C2;"></Label>
                        <!-- <Label Content="Home"></Label> -->
                    </StackPanel>
                </Button>
                <Button Background="Aqua">
                    <Label FontFamily="{DynamicResource Phosphor-Fill}" Classes="icon" Content="&#xE1D2;"></Label>
                </Button>
                <Button Background="Aqua">
                    <Label FontFamily="{DynamicResource Phosphor-Fill}" Classes="icon" Content="&#xEA04;"></Label>
                </Button>
                <Button Background="Aqua">
                    <Label FontFamily="{DynamicResource Phosphor-Fill}" Classes="icon" Content="&#xE4AE;"></Label>
                </Button>
                <Button Background="Aqua">
                    <Label FontFamily="{DynamicResource Phosphor-Fill}" Classes="icon" Content="&#xE10A;"></Label>
                </Button>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2">
                <Button Focusable="False" Background="Aqua" Name="Settings">
                    <Label FontFamily="{DynamicResource Phosphor-Fill}" Classes="icon" Content="&#xE270;"></Label>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
