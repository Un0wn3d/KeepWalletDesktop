<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KeepWalletDesktop.App"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
             xmlns:local="using:KeepWalletDesktop"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             xmlns:scg="clr-namespace:System.Collections.Generic;assembly=netstandard"
             RequestedThemeVariant="Light">
             <!-- The app uses a custom light palette, so keep Fluent controls in the matching theme. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://KeepWalletDesktop/Assets/Styles/AppTheme.axaml"/>
        <StyleInclude Source="avares://KeepWalletDesktop/Assets/Styles/CalendarStyles.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://KeepWalletDesktop/Assets/Styles/Fonts.axaml"/>
                <ResourceInclude Source="avares://KeepWalletDesktop/Assets/Styles/Themes/Light/Theme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

